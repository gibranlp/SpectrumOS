<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SpectrumOS</vendor>
  <action id="org.spectrumos.app-store.install">
    <description>Install applications and upgrade system packages</description>
    <message>Authentication is required to install applications and upgrade system packages.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/spectrumos/app-store-privileged</annotate>
  </action>
</policyconfig>
