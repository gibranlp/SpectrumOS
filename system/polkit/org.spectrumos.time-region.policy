<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SpectrumOS</vendor>
  <action id="org.spectrumos.time-region.configure">
    <description>Configure system language, region and NTP servers</description>
    <message>Authentication is required to update system language, regional formats or NTP servers.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/spectrumos/time-region-adapter</annotate>
  </action>
</policyconfig>
