#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys
import tempfile
import time


def state_path():
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "spectrumos/questline-widget.json"


def main():
    path = state_path()
    try:
        if sys.argv[1:] == ["read"]:
            state = json.loads(path.read_text()) if path.exists() else {"version": 1}
            if not isinstance(state, dict) or state.get("version") != 1:
                raise ValueError("Unsupported draft format")
            print(json.dumps({"state": state}))
        elif sys.argv[1:] in (["write"],["archive"]):
            state = json.loads(sys.stdin.readline())
            if not isinstance(state, dict) or state.get("version") != 1:
                raise ValueError("Unsupported draft format")
            if sys.argv[1:]==["archive"]:
                path=path.parent/'questline-draft-backups'/('before-profile-switch-'+str(time.time_ns())+'.json')
                path.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
                path.parent.chmod(0o700)
            path.parent.mkdir(parents=True, exist_ok=True)
            temporary = None
            try:
                with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, prefix=".questline-widget-", delete=False) as output:
                    temporary = output.name
                    os.fchmod(output.fileno(), 0o600)
                    json.dump(state, output)
                    output.flush()
                    os.fsync(output.fileno())
                os.replace(temporary, path)
                temporary = None
            finally:
                if temporary:
                    Path(temporary).unlink(missing_ok=True)
            print(json.dumps({"ok": True}))
        else:
            raise ValueError("Use read, write or archive")
        return 0
    except (OSError, ValueError) as error:
        print(json.dumps({"error": str(error)}))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
