#!/usr/bin/env python3
import os
from pathlib import Path
import shutil
import subprocess
import sys

local=Path.home()/'.local/bin/questline'
binary=str(local) if local.is_file() and os.access(local,os.X_OK) else shutil.which('questline')
if not binary:
    print('Questline is required for background sync.',file=sys.stderr)
    raise SystemExit(1)
result=subprocess.run([binary,'--help'],capture_output=True,text=True,timeout=5)
if result.returncode or 'sync-background' not in result.stdout:
    print('Update Questline to enable background sync.',file=sys.stderr)
    raise SystemExit(1)
os.execv(binary,[binary,'sync-background'])
