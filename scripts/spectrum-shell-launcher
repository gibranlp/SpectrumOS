#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)) || { (($# == 1)) && [[ $1 != --repo ]]; }; then
    printf 'Usage: %s [--repo]\n' "$0" >&2
    exit 2
fi

if (($# == 1)); then
    config_dir=$(realpath -- "$(dirname -- "${BASH_SOURCE[0]}")/../configs/spectrum-shell")
else
    config_dir=/usr/share/spectrumos/spectrum-shell
fi

if command -v qs >/dev/null 2>&1; then
    for _ in 1 2 3; do
        response=$(qs --path "$config_dir" ipc call spectrum-shell toggleLauncher 2>&1) && [[ -z $response ]] && exit 0
        [[ $response == *'Not ready to accept queries yet.'* ]] || break
        sleep 0.1
    done
fi
exec /usr/lib/spectrumos/application-menu
