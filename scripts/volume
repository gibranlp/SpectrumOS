#!/usr/bin/env bash
set -euo pipefail

if (($# > 3)) || { (($# == 3)) && [[ $1 != set || $3 != --quiet ]]; }; then
    printf 'Usage: %s up|down|mute [--quiet] | set 0-100 [--quiet]\n' "$0" >&2
    exit 2
fi

case ${1:-} in
    up) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+ ;;
    down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%- ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    set)
        [[ ${2:-} =~ ^[0-9]{1,3}$ ]] && ((10#$2 <= 100)) || exit 2
        wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "$2%"
        ;;
    *) printf 'Usage: %s up|down|mute [--quiet] | set 0-100 [--quiet]\n' "$0" >&2; exit 2 ;;
esac
