#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from pathlib import Path
import re
import tempfile
import tomllib


KITTY_INCLUDE = "include /usr/share/spectrumos/terminal/kitty-spectrum.conf"
ALACRITTY_INCLUDE = "/usr/share/spectrumos/terminal/alacritty-spectrum.toml"
LEGACY_ALACRITTY = {
    "general": {"import": ["~/.cache/spectrumos/theme/current/alacritty.toml"], "live_config_reload": True},
    "window": {"dynamic_title": True, "decorations": "None", "opacity": 1.0},
    "scrolling": {"history": 10000}, "selection": {"save_to_clipboard": True},
    "cursor": {"unfocused_hollow": True},
}


def write_config(path: Path, contents: str) -> bool:
    if path.is_symlink():
        raise ValueError(f"Keeping linked terminal configuration: {path}")
    if path.exists() and path.read_text() == contents:
        return False
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False) as staged:
        temporary = Path(staged.name)
        try:
            staged.write(contents)
            staged.flush()
            os.fsync(staged.fileno())
            os.chmod(temporary, mode)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)
    return True


def backup(path: Path) -> None:
    if path.exists():
        saved = path.with_name(path.name + ".pre-spectrum-managed")
        if not saved.exists() and not saved.is_symlink():
            with saved.open("x", encoding="utf-8") as stream:
                os.chmod(saved, path.stat().st_mode & 0o777)
                stream.write(path.read_text())


def configure(home: Path) -> None:
    config = home / ".config"
    for directory in (config, config / "kitty", config / "alacritty"):
        if directory.is_symlink():
            raise ValueError(f"Keeping linked terminal configuration directory: {directory}")
        directory.mkdir(parents=True, exist_ok=True)
    kitty = config / "kitty"
    spectrum = kitty / "spectrum.conf"
    if spectrum.is_symlink():
        raise ValueError(f"Keeping linked terminal configuration: {spectrum}")
    if not spectrum.exists():
        write_config(spectrum, KITTY_INCLUDE + "\n")
    elif "include ~/.cache/spectrumos/theme/current/kitty.conf" in spectrum.read_text():
        text = spectrum.read_text()
        backup(spectrum)
        text = text.replace("include ~/.cache/spectrumos/theme/current/kitty.conf", KITTY_INCLUDE)
        # Solo se retiran los valores conocidos de la copia anterior; los ajustes personales quedan.
        text = re.sub(r"(?m)^\s*(remember_window_size\s+(?:yes|no)|map ctrl\+c copy_to_clipboard|map ctrl\+v paste_from_clipboard|map ctrl\+shift\+c send_key ctrl\+c)\s*$", "", text)
        write_config(spectrum, text)
    main = kitty / "kitty.conf"
    if main.is_symlink():
        raise ValueError(f"Keeping linked terminal configuration: {main}")
    text = main.read_text() if main.exists() else ""
    if KITTY_INCLUDE not in text and not re.search(r"(?m)^\s*include\s+spectrum\.conf\s*$", text):
        backup(main)
        write_config(main, KITTY_INCLUDE + "\n" + text)

    alacritty = config / "alacritty" / "alacritty.toml"
    if alacritty.is_symlink():
        raise ValueError(f"Keeping linked terminal configuration: {alacritty}")
    imports = [ALACRITTY_INCLUDE]
    if alacritty.exists():
        text = alacritty.read_text()
        data = tomllib.loads(text)
        if ALACRITTY_INCLUDE in data.get("general", {}).get("import", []):
            return
        backup(alacritty)
        if data != LEGACY_ALACRITTY:
            local = alacritty.with_name("spectrum-local.toml")
            if local.exists() or local.is_symlink():
                raise ValueError(f"Keeping existing personal terminal configuration: {local}")
            write_config(local, text)
            imports.append("spectrum-local.toml")
    import json
    write_config(alacritty, "[general]\nimport = " + json.dumps(imports) + "\n")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Link terminal defaults to SpectrumOS packages while preserving personal settings")
    parser.add_argument("--home", type=Path, default=Path.home())
    args = parser.parse_args()
    try:
        configure(args.home)
    except (OSError, ValueError) as error:
        parser.exit(1, f"Terminal configuration: {error}\n")
