def sync_rgb() -> None:
    sync_legion_rgb()
    sync_keychron_rgb()
    sync_win60_rgb()


def apply(include_rgb: bool = True) -> str:
    metadata = json.loads((CURRENT / "palette.json").read_text(encoding="utf-8"))
    if include_rgb:
        sync_rgb()
    variant = metadata.get("variant", "dark")
    failures = []

    def refresh(name, action):
        try:
            action()
        except (OSError, ValueError, KeyError, RuntimeError, configparser.Error, subprocess.SubprocessError) as error:
            failures.append(name)
            print(f"Appearance {name}: {error}", file=sys.stderr)

    def gtk():
        theme = ensure_gtk_theme(variant)
        for version in ("3", "4"):
            refresh("GTK " + version, lambda version=version: (ensure_import(version), ensure_gtk_settings(version, theme, variant)))
        setting("org.gnome.desktop.interface", "gtk-theme", theme)
        setting("org.gnome.desktop.interface", "color-scheme", "prefer-dark" if variant == "dark" else "prefer-light")

    def icons():
        if ensure_icon_theme():
            setting("org.gnome.desktop.interface", "icon-theme", "Adwaita")
        setting("org.gnome.desktop.interface", "icon-theme", "Spectrum")

    def cursor():
        if (CONFIG_HOME / "spectrumos/mouse.json").exists():
            helper = Path(__file__).resolve().with_name("mouse-adapter")
            subprocess.run((str(helper), "--cursor"), check=True, timeout=30)

    size = font_size()
    for name, action in (
        ("GTK", gtk), ("Qt/Kvantum", select_kvantum), ("icons", icons),
        ("cursor", cursor), ("GTK fonts", lambda: sync_gtk_font_size(size)),
        ("Qt fonts", lambda: sync_qt_font_size(size)), ("Cava", ensure_cava),
        ("Vencord", ensure_vencord), ("Zen", ensure_zen_browser), ("GameMode", ensure_gamemode_hook),
    ):
        refresh(name, action)
    try:
        subprocess.run(("pkill", "-USR1", "-u", str(os.getuid()), "-x", "cava"), check=False, timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        pass
    if failures:
        raise RuntimeError("Could not refresh: " + ", ".join(failures))
    return variant


def status() -> None:
    try:
        variant = json.loads((CURRENT / "palette.json").read_text(encoding="utf-8"))["variant"]
    except (OSError, KeyError, json.JSONDecodeError):
        variant = "unavailable"
    gtk = all((CONFIG_HOME / f"gtk-{version}.0/spectrum.css").is_file() for version in ("3", "4"))
    qt = all((CONFIG_HOME / f"Kvantum/Spectrum/Spectrum.{suffix}").is_symlink() for suffix in ("kvconfig", "colors", "svg"))
    icons = (DATA_HOME / "icons/Spectrum/.spectrum-managed").is_file()
    quick_css = CONFIG_HOME / "vesktop/settings/quickCss.css"
    vencord = quick_css.is_file() and VENCORD_BEGIN in quick_css.read_text(encoding="utf-8")
    zen_profile = None
    for zen_root in zen_profile_roots():
        zen_profile = zen_default_profile(zen_root)
        if zen_profile is not None:
            break
    zen = False
    if zen_profile is not None:
        user_chrome = zen_profile / "chrome/userChrome.css"
        xpi = zen_profile / "extensions" / f"{ZEN_EXTENSION_ID}.xpi"
        zen = (
            user_chrome.is_file() and ZEN_BEGIN in user_chrome.read_text(encoding="utf-8")
            and xpi.is_file()
        )
    print(json.dumps({"variant": variant, "gtk3": gtk, "gtk4": gtk, "qt5": qt, "qt6": qt, "icons": icons, "vencord": vencord, "zen": zen}))


if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["--status"]:
            status()
        elif sys.argv[1:] == ["--rgb-only"]:
            sync_rgb()
        elif not sys.argv[1:] or sys.argv[1:] in (["--apply"], ["--desktop-only"]):
            directory = CONFIG_HOME / "spectrumos"
            directory.mkdir(parents=True, exist_ok=True)
            with (directory / ".appearance.lock").open("a") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                apply(include_rgb=sys.argv[1:] != ["--desktop-only"])
        else:
            raise SystemExit(f"Usage: {sys.argv[0]} [--apply|--desktop-only|--rgb-only|--status]")
    except (OSError, KeyError, json.JSONDecodeError, RuntimeError) as error:
        print(f"Error: {error}", file=sys.stderr)
        raise SystemExit(1) from error
