#!/usr/bin/env python3
from __future__ import annotations

import argparse
from pathlib import Path
import subprocess


ARCH_SPLASH = "--splash /usr/share/systemd/bootctl/splash-arch.bmp"


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Remove the Arch splash from SpectrumOS unified kernel images")
    parser.add_argument("--cmdline", type=Path, default=Path("/etc/kernel/cmdline"))
    parser.add_argument("--preset-dir", type=Path, default=Path("/etc/mkinitcpio.d"))
    parser.add_argument("--rebuild", action="store_true")
    return parser.parse_args()


def update_cmdline(path: Path) -> bool:
    if not path.is_file():
        return False
    parameters = path.read_text(encoding="utf-8").split()
    if "logo.nologo" not in parameters:
        path.write_text(" ".join(parameters + ["logo.nologo"]) + "\n", encoding="utf-8")
        return True
    return False


def update_presets(directory: Path) -> bool:
    changed = False
    for path in sorted(directory.glob("*.preset")):
        content = path.read_text(encoding="utf-8")
        updated = content.replace(ARCH_SPLASH, "").replace('default_options=" "', 'default_options=""')
        if updated != content:
            path.write_text(updated, encoding="utf-8")
            changed = True
    return changed


def main() -> int:
    options = arguments()
    changed = update_cmdline(options.cmdline) | update_presets(options.preset_dir)
    if changed and options.rebuild:
        subprocess.run(["mkinitcpio", "-P"], check=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
