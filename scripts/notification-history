#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys
import time


STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "spectrumos/notifications/history.json"


def read_items() -> list[dict[str, str]]:
    try:
        value = json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    return value if isinstance(value, list) else []


def save_items(items: list[dict[str, str]]) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temporary = STATE.with_name(f".{STATE.name}.{os.getpid()}.tmp")
    temporary.write_text(json.dumps(items[-100:], ensure_ascii=False), encoding="utf-8")
    temporary.replace(STATE)


def main() -> int:
    if sys.argv[1:] == ["--json"]:
        print(json.dumps({"items": read_items()}, ensure_ascii=False))
        return 0
    if sys.argv[1:] == ["--clear"]:
        save_items([])
        return 0
    if sys.argv[1:] == ["--add"]:
        try:
            item = json.loads(sys.stdin.readline())
        except ValueError:
            return 2
        if not isinstance(item, dict):
            return 2
        cleaned = {
            "appName": str(item.get("appName", "Application"))[:100],
            "summary": str(item.get("summary", ""))[:300],
            "body": str(item.get("body", ""))[:1500],
            "received": time.strftime("%Y-%m-%d %H:%M"),
        }
        save_items(read_items() + [cleaned])
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
