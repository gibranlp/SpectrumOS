#!/usr/bin/env python
from __future__ import annotations

import configparser
import fcntl
import io
import json
import math
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import tempfile

CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
STATE = CONFIG / "spectrumos/mouse.json"
BASE = Path("/usr/share/icons/Adwaita/cursors")
DEFAULTS = dict(sensitivity=0.0, scroll_factor=1.0, natural_scroll=False,
                cursor_size=24, adaptive_cursor=False, cursor_theme="Adwaita")


def run(*args: str) -> str:
    result = subprocess.run(args, capture_output=True, text=True, timeout=10)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or f"{args[0]} failed")
    return result.stdout.strip()


def validate(key: str, value):
    if key in ("sensitivity", "scroll_factor"):
        number = float(value)
        low, high = (-1, 1) if key == "sensitivity" else (0.1, 10)
        if not math.isfinite(number) or not low <= number <= high:
            raise ValueError(f"{key} must be between {low} and {high}")
        return number
    if key == "cursor_size":
        number = int(value)
        if number not in (16, 24, 32, 48, 64):
            raise ValueError("Cursor size must be 16, 24, 32, 48 or 64")
        return number
    if key in ("natural_scroll", "adaptive_cursor"):
        if isinstance(value, bool):
            return value
        if value not in ("on", "off"):
            raise ValueError(f"{key} must be on or off")
        return value == "on"
    if key == "cursor_theme" and isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9_. -]+", value):
        return value
    raise ValueError("Unknown mouse setting")


def settings() -> dict:
    values = DEFAULTS.copy()
    if STATE.exists():
        saved = json.loads(STATE.read_text())
        for key in DEFAULTS:
            if key in saved:
                values[key] = validate(key, saved[key])
    else:
        for key in ("sensitivity", "scroll_factor", "natural_scroll"):
            try:
                live = json.loads(run("hyprctl", "-j", "getoption", f"input:{key}"))
                values[key] = validate(key, live["bool" if key == "natural_scroll" else "float"])
            except (OSError, RuntimeError, ValueError, KeyError):
                pass
        try:
            values["cursor_theme"] = validate("cursor_theme", run("gsettings", "get", "org.gnome.desktop.interface", "cursor-theme").strip("'"))
            values["cursor_size"] = validate("cursor_size", run("gsettings", "get", "org.gnome.desktop.interface", "cursor-size"))
        except (OSError, RuntimeError, ValueError):
            pass
    return values


def atomic(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=f".{path.name}.", delete=False) as stream:
        temporary = Path(stream.name)
        try:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
            os.chmod(temporary, 0o644)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def recolor(source: bytes, color: str) -> bytes:
    # Conserva tamaños, hotspots y animaciones; solo tiñe las zonas claras del cursor.
    data = bytearray(source)
    magic, header, version, count = struct.unpack_from("<4I", data)
    if magic != 0x72756358 or header < 16 or header + count * 12 > len(data):
        raise ValueError("Invalid Xcursor header")
    rgb = [int(color[index:index + 2], 16) for index in (1, 3, 5)]
    visited = set()
    for index in range(count):
        kind, size, offset = struct.unpack_from("<3I", data, header + index * 12)
        if kind != 0xFFFD0002 or offset in visited:
            continue
        visited.add(offset)
        chunk_header, chunk_type, subtype, chunk_version, width, height, xhot, yhot, delay = struct.unpack_from("<9I", data, offset)
        start = offset + chunk_header
        if chunk_header < 36 or chunk_type != kind or width * height > 1024 * 1024 or start + width * height * 4 > len(data):
            raise ValueError("Invalid Xcursor image")
        for position in range(start, start + width * height * 4, 4):
            blue, green, red, alpha = data[position:position + 4]
            if alpha and min(red, green, blue) / alpha > 0.55:
                brightness = max(red, green, blue) / alpha
                tinted = [round(channel * brightness * alpha / 255) for channel in rgb]
                data[position:position + 3] = bytes(reversed(tinted))
    return bytes(data)


def cursor_theme(values: dict) -> str:
    if not values["adaptive_cursor"]:
        return values["cursor_theme"]
    palette = json.loads((CACHE / "spectrumos/theme/current/palette.json").read_text())
    color = palette["roles"]["accent"]
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", color):
        raise ValueError("Invalid cursor accent color")
    name = "SpectrumCursor-" + color[1:].lower()
    target = DATA / "icons" / name
    if not (target / "index.theme").exists():
        if not BASE.is_dir():
            raise RuntimeError("Install adwaita-cursors to enable adaptive cursors")
        target.parent.mkdir(parents=True, exist_ok=True)
        staging = Path(tempfile.mkdtemp(prefix=".SpectrumCursor-", dir=target.parent))
        try:
            for source in sorted(BASE.iterdir()):
                destination = staging / "cursors" / source.name
                if source.is_symlink():
                    destination.parent.mkdir(parents=True, exist_ok=True)
                    destination.symlink_to(os.readlink(source))
                elif source.is_file():
                    atomic(destination, recolor(source.read_bytes(), color))
            atomic(staging / "index.theme", f"[Icon Theme]\nName={name}\nInherits=Adwaita\n".encode())
            os.replace(staging, target)
        finally:
            if staging.exists():
                shutil.rmtree(staging)
    return name


def sync_cursor(values: dict) -> str:
    theme = cursor_theme(values)
    size = str(values["cursor_size"])
    for version in (3, 4):
        path = CONFIG / f"gtk-{version}.0/settings.ini"
        if path.is_symlink():
            raise RuntimeError(f"Cannot replace symlinked GTK settings: {path}")
        parser = configparser.ConfigParser(interpolation=None)
        parser.optionxform = str
        if path.exists():
            parser.read(path)
        if not parser.has_section("Settings"):
            parser.add_section("Settings")
        parser["Settings"]["gtk-cursor-theme-name"] = theme
        parser["Settings"]["gtk-cursor-theme-size"] = size
        stream = io.StringIO()
        parser.write(stream)
        atomic(path, stream.getvalue().encode())
    atomic(CONFIG / "spectrumos/mouse-cursor.lua", (
        f'hl.env("XCURSOR_THEME", "{theme}")\nhl.env("XCURSOR_SIZE", "{size}")\n'
        f'hl.env("HYPRCURSOR_SIZE", "{size}")\n').encode())
    for key, value in (("cursor-theme", theme), ("cursor-size", size)):
        run("gsettings", "set", "org.gnome.desktop.interface", key, value)
    run("hyprctl", "setcursor", theme, size)
    run("systemctl", "--user", "set-environment", f"XCURSOR_THEME={theme}", f"XCURSOR_SIZE={size}", f"HYPRCURSOR_SIZE={size}")
    return theme


def input_lua(values: dict) -> str:
    return ('hl.config({ input = { '
            f'sensitivity = {values["sensitivity"]}, scroll_factor = {values["scroll_factor"]}, '
            f'natural_scroll = {str(values["natural_scroll"]).lower()}'
            ' } })\n')


def main(args: list[str]) -> None:
    if args == ["--json"]:
        print(json.dumps(settings()))
        return
    if args not in (["--apply"], ["--cursor"], ["--reset-input"]) and not (len(args) == 3 and args[0] == "--set"):
        raise ValueError("Usage: mouse-adapter --json|--apply|--cursor|--set SETTING VALUE")
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with (STATE.parent / ".mouse.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        values = settings()
        if args == ["--reset-input"]:
            values.update({key: DEFAULTS[key] for key in ("sensitivity", "scroll_factor", "natural_scroll")})
        if args[0] == "--set":
            if args[1] == "cursor_theme":
                raise ValueError("Cursor theme is managed by the adaptive cursor switch")
            values[args[1]] = validate(args[1], args[2])
        if args != ["--cursor"]:
            run("hyprctl", "eval", input_lua(values))
        if args[0] != "--set" or args[1] in ("cursor_size", "adaptive_cursor"):
            sync_cursor(values)
        if args != ["--cursor"]:
            atomic(CONFIG / "spectrumos/mouse.lua", input_lua(values).encode())
            atomic(STATE, (json.dumps(values, indent=2) + "\n").encode())


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, KeyError, struct.error, RuntimeError, subprocess.TimeoutExpired) as error:
        print(f"Mouse settings: {error}", file=sys.stderr)
        sys.exit(1)
