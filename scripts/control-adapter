#!/usr/bin/env python
from __future__ import annotations

import json
import subprocess
import sys


def run(arguments: tuple[str, ...], timeout: int = 4) -> subprocess.CompletedProcess[str]:
    return subprocess.run(arguments, check=False, capture_output=True, text=True, timeout=timeout)


def launch(arguments: tuple[str, ...]) -> None:
    subprocess.Popen(arguments, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def audio_state() -> dict[str, object]:
    try:
        sinks = json.loads(run(("pactl", "-f", "json", "list", "sinks")).stdout or "[]")
        sources = json.loads(run(("pactl", "-f", "json", "list", "sources")).stdout or "[]")
        default_sink = run(("pactl", "get-default-sink")).stdout.strip()
        default_source = run(("pactl", "get-default-source")).stdout.strip()
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return {"available": False, "output": "Unavailable", "input": "Unavailable", "volume": "—", "muted": False, "sinks": [], "sources": []}

    def rows(items: list[dict[str, object]], default: str, include_monitors: bool = True) -> list[dict[str, object]]:
        result_by_name = {}
        for item in items:
            name = str(item.get("name", ""))
            if not include_monitors and name.endswith(".monitor"):
                continue
            description = str(item.get("description", name))
            volume = item.get("volume", {})
            channels = list(volume.values()) if isinstance(volume, dict) else []
            percent = channels[0].get("value_percent", "—") if channels and isinstance(channels[0], dict) else "—"
            percentages = [float(str(channel.get("value_percent", "")).rstrip("%")) for channel in channels if isinstance(channel, dict) and str(channel.get("value_percent", "")).rstrip("%").replace(".", "", 1).isdigit()]
            level = round(sum(percentages) / len(percentages)) if percentages else None
            result_by_name[name] = {"id": str(item.get("index", "")), "name": name, "label": description, "default": name == default, "volume": percent, "volume_percent": level, "muted": bool(item.get("mute", False))}
        return list(result_by_name.values())

    output_rows = rows(sinks, default_sink)
    input_rows = rows(sources, default_source, include_monitors=False)
    active_output = next((item for item in output_rows if item["default"]), output_rows[0] if output_rows else None)
    active_input = next((item for item in input_rows if item["default"]), input_rows[0] if input_rows else None)
    return {
        "available": bool(output_rows),
        "output": active_output["label"] if active_output else "No output",
        "input": active_input["label"] if active_input else "No input",
        "volume": active_output["volume"] if active_output else "—",
        "muted": active_output["muted"] if active_output else False,
        "sinks": output_rows,
        "sources": input_rows,
    }


def display_state() -> dict[str, object]:
    try:
        monitors = json.loads(run(("hyprctl", "-j", "monitors")).stdout or "[]")
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        monitors = []
    try:
        layout = json.loads(run(("/usr/lib/spectrumos/workspace-layout", "--json")).stdout or "{}")
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        layout = {}
    assignments = layout.get("assignments", {})
    workspace_monitors = layout.get("workspace_monitors", {})
    primary_name = layout.get("primary", "")
    workspace_counts = {name: list(workspace_monitors.values()).count(name) for name in workspace_monitors.values()}
    rows = []
    for monitor in monitors:
        native_width, native_height = monitor.get("width", 0), monitor.get("height", 0)
        width, height = native_width, native_height
        if monitor.get("transform", 0) in (1, 3, 5, 7):
            width, height = height, width
        available_modes = list(dict.fromkeys(str(mode).removesuffix("Hz") for mode in monitor.get("availableModes", [])))
        mode_choices = []
        seen_resolutions = set()
        for mode in available_modes:
            resolution = mode.partition("@")[0]
            if resolution in seen_resolutions:
                continue
            seen_resolutions.add(resolution)
            mode_choices.append({"value": mode, "label": mode.replace("x", "×")})
            if len(mode_choices) == 6:
                break
        while len(mode_choices) < 6:
            mode_choices.append({"value": "", "label": ""})
        rows.append({
            "name": monitor.get("name", "Display"),
            "description": monitor.get("description", "Active display"),
            "resolution": f"{width}×{height}",
            "refresh": f"{monitor.get('refreshRate', 0):.0f} Hz",
            "scale": f"{monitor.get('scale', 1):g}×",
            "focused": bool(monitor.get("focused", False)),
            "primary": monitor.get("name", "") == primary_name,
            "position": f"{monitor.get('x', 0)}×{monitor.get('y', 0)}",
            "transform": int(monitor.get("transform", 0)),
            "mode": f"{native_width}x{native_height}@{monitor.get('refreshRate', 0):.2f}",
            "modes": available_modes,
            "mode_choices": mode_choices,
            "mode_1": mode_choices[0],
            "mode_2": mode_choices[1],
            "mode_3": mode_choices[2],
            "mode_4": mode_choices[3],
            "mode_5": mode_choices[4],
            "mode_6": mode_choices[5],
            "workspaces": assignments.get(monitor.get("name", ""), "Automatic"),
            "workspace_choices": [
                {
                    "id": workspace,
                    "assigned": workspace_monitors.get(str(workspace)) == monitor.get("name", ""),
                    "assignable": workspace_counts.get(workspace_monitors.get(str(workspace)), 0) > 1
                    or workspace_monitors.get(str(workspace)) == monitor.get("name", ""),
                }
                for workspace in range(1, 7)
            ],
        })
    focused = next((row["name"] for row in rows if row["focused"]), rows[0]["name"] if rows else "")
    return {"count": len(rows), "focused": focused, "monitors": rows}


def display_action(name: str, value: str = "", setting: str = "") -> None:
    state = display_state()
    monitor = next((item for item in state["monitors"] if item["name"] == value), None)
    primary = next((item for item in state["monitors"] if item["primary"]), None)
    if name in ("right", "left", "down", "up"):
        result = run(("/usr/lib/spectrumos/display-menu", "--arrange", name), timeout=12)
    elif name == "reset":
        result = run(("/usr/lib/spectrumos/display-menu", "--reset"), timeout=12)
    elif name == "settings":
        launch(("/usr/lib/spectrumos/display-menu",))
        return
    elif monitor and name in ("primary", "workspace-primary"):
        result = run(("/usr/lib/spectrumos/workspace-layout", "--primary", value), timeout=12)
    elif monitor and name == "workspace" and setting in {str(workspace) for workspace in range(1, 7)}:
        result = run(("/usr/lib/spectrumos/workspace-layout", "--workspace", setting, value), timeout=12)
    elif monitor and primary and name in ("place-left", "place-right", "place-up", "place-down"):
        direction = name.removeprefix("place-")
        result = run(("/usr/lib/spectrumos/display-menu", "--relative", value, str(primary["name"]), direction), timeout=12)
    elif monitor and name == "rotate" and setting in {"0", "1", "2", "3"}:
        result = run(("/usr/lib/spectrumos/display-menu", "--rotate", value, setting), timeout=12)
    elif monitor and name == "scale" and setting in {"1", "1.25", "1.5", "1.75", "2"}:
        result = run(("/usr/lib/spectrumos/display-menu", "--scale", value, setting), timeout=12)
    elif monitor and name == "mode" and setting in monitor["modes"]:
        result = run(("/usr/lib/spectrumos/display-menu", "--mode", value, setting), timeout=12)
    else:
        raise ValueError("Unsupported display action")
    if result.returncode != 0:
        raise ValueError(result.stderr.strip() or "Display action failed")


def state() -> None:
    print(json.dumps({"audio": audio_state(), "display": display_state()}))


def audio_action(name: str, value: str = "", setting: str = "") -> None:
    output = name.startswith("output")
    if name not in {"output", "input", "output-volume", "input-volume", "output-mute", "input-mute"} or not value.isdigit():
        raise ValueError("Unsupported audio action")
    rows = audio_state()["sinks" if output else "sources"]
    device = next((row for row in rows if row["id"] == value), None)
    if device is None:
        raise ValueError("Unknown audio device")
    target = "sink" if output else "source"
    if name.endswith("-volume"):
        if not setting.isdigit() or not 0 <= int(setting) <= 100:
            raise ValueError("Audio volume must be between 0 and 100")
        command = ("pactl", f"set-{target}-volume", str(device["name"]), f"{int(setting)}%")
    elif name.endswith("-mute"):
        command = ("pactl", f"set-{target}-mute", str(device["name"]), "toggle")
    else:
        command = ("pactl", f"set-default-{target}", str(device["name"]))
    result = run(command)
    if result.returncode:
        raise ValueError(result.stderr.strip() or "Audio device change failed")


def main() -> None:
    arguments = sys.argv[1:]
    if arguments == ["--audio-json"]:
        print(json.dumps(audio_state()))
        return
    if arguments == ["--display-json"]:
        print(json.dumps(display_state()))
        return
    if not arguments or arguments == ["--json"]:
        state()
        return
    try:
        if arguments[0] == "audio":
            audio_action(arguments[1], arguments[2] if len(arguments) > 2 else "", arguments[3] if len(arguments) > 3 else "")
        elif arguments[0] == "display":
            display_action(
                arguments[1],
                arguments[2] if len(arguments) > 2 else "",
                arguments[3] if len(arguments) > 3 else "",
            )
        else:
            raise ValueError("Unknown control action")
    except (IndexError, OSError, subprocess.TimeoutExpired, ValueError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(2) from error


if __name__ == "__main__":
    main()
