#!/usr/bin/env python3
import os
from pathlib import Path
import shutil
import sys
import subprocess
import time

local=Path.home()/'.local/bin/questline'
binary=str(local) if local.is_file() and os.access(local,os.X_OK) else shutil.which('questline')
if not binary:
    print('Questline 2.0.2 or newer is required for desktop reminders.',file=sys.stderr)
    raise SystemExit(1)
for attempt in range(30):
    try:
        ready=subprocess.run(['busctl','--user','status','org.freedesktop.Notifications'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=2).returncode==0
    except (OSError,subprocess.TimeoutExpired):
        ready=False
    if ready:break
    time.sleep(0.25)
else:
    print('Waiting for the desktop notification server.',file=sys.stderr)
    raise SystemExit(1)
os.execv(binary,[binary,'desktop-notifications'])
