#!/usr/bin/env python3
import json
import os
import re
from pathlib import Path
from decimal import Decimal
import secrets
import string
import subprocess
import sys
import tempfile
import time
import unicodedata

COLOR_HISTORY_LIMIT = 60


def search(query: str) -> int:
    query = query.casefold().strip()
    if len(query) < 2:
        print("[]")
        return 0
    roots = [Path.home() / name for name in ("Desktop", "Documents", "Downloads", "Music", "Pictures", "Videos")]
    roots = [root for root in roots if root.is_dir()]
    if not roots:
        roots = [Path.home()]
    matches = []
    for root in roots:
        for directory, folders, files in os.walk(root):
            folders[:] = [name for name in folders if not name.startswith(".")]
            for name in files:
                if name.startswith(".") or query not in name.casefold():
                    continue
                matches.append(str(Path(directory) / name))
                if len(matches) == 60:
                    print(json.dumps(matches, ensure_ascii=False))
                    return 0
    print(json.dumps(matches, ensure_ascii=False))
    return 0



def search_preferences():
    return Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "spectrumos/search.json"


def search_saved():
    try:
        value = json.loads(search_preferences().read_text())
        if isinstance(value, dict) and isinstance(value.get("root"), str):
            return value
    except (OSError, ValueError):
        pass
    return {"root": str(Path.home()), "recent": []}


def search_directory(value):
    if not isinstance(value, str) or not value.strip() or len(value) > 4096 or "\0" in value:
        raise ValueError("Enter a folder path.")
    path = Path(value.strip()).expanduser()
    if not path.is_absolute():
        raise ValueError("Use an absolute folder path, such as /media/Music, or ~/Music.")
    if not path.is_dir():
        raise ValueError("Folder is unavailable. Check its path and whether the drive is mounted.")
    if not os.access(path, os.R_OK | os.X_OK):
        raise ValueError("You do not have permission to search this folder.")
    return path.resolve()


def search_locations(saved):
    values = []
    seen = set()
    def add(path, label):
        path = str(path)
        if path not in seen:
            seen.add(path)
            values.append({"path": path, "name": label})
    add(Path.home(), "Home")
    for name in ("Desktop", "Documents", "Downloads", "Music", "Pictures", "Videos"):
        path = Path.home() / name
        if path.is_dir():
            add(path, name)
    try:
        for line in Path("/proc/self/mountinfo").read_text().splitlines():
            parts = line.split()
            if len(parts) < 6:
                continue
            path = re.sub(r"\\([0-7]{3})", lambda match: chr(int(match[1], 8)), parts[4])
            if any(path.startswith(prefix) for prefix in ("/media/", "/mnt/", "/run/media/")):
                add(path, Path(path).name + " · " + path)
    except OSError:
        pass
    recent = saved.get("recent") if isinstance(saved.get("recent"), list) else []
    for path in [saved.get("root"), *recent[:8]]:
        if isinstance(path, str) and path.startswith("/"):
            add(path, path)
    return values


def search_state(selected=None):
    saved = search_saved()
    if selected is not None:
        root = search_directory(selected)
        recent = saved.get("recent") if isinstance(saved.get("recent"), list) else []
        recent = list(dict.fromkeys([str(root)] + [v for v in recent if isinstance(v, str)]))[:8]
        saved = {"root": str(root), "recent": recent}
        path = search_preferences()
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd, temporary = tempfile.mkstemp(prefix=".search-", dir=path.parent)
        try:
            with os.fdopen(fd, "w") as output:
                json.dump(saved, output, ensure_ascii=False)
            os.replace(temporary, path)
        finally:
            Path(temporary).unlink(missing_ok=True)
    result = {"root": saved["root"], "locations": search_locations(saved)}
    try:
        search_directory(saved["root"])
        result["ok"] = True
    except (OSError, ValueError, RuntimeError) as error:
        result.update(ok=False, error=str(error))
    return result


def scoped_search(request):
    if not isinstance(request, dict):
        raise ValueError("Expected search options.")
    query = request.get("query", "")
    result = {"request_id": request.get("request_id"), "matches": [], "limited": False, "timed_out": False, "skipped": 0}
    try:
        if not isinstance(query, str) or len(query) > 4096:
            raise ValueError("Enter a shorter search query.")
        root = search_directory(request.get("root", ""))
        result["root"] = str(root)
        needle = query.casefold().strip()
        if len(needle) < 2:
            return {**result, "ok": True}
        deadline = time.monotonic() + 8
        def unreadable(error):
            result["skipped"] += 1
        # No sigue carpetas enlazadas: evita ciclos y recorridos fuera de la ubicación elegida.
        for directory, folders, files in os.walk(root, onerror=unreadable, followlinks=False):
            folders[:] = sorted(name for name in folders if not name.startswith("."))
            files.sort()
            for name in files:
                if time.monotonic() >= deadline:
                    return {**result, "ok": True, "timed_out": True}
                if not name.startswith(".") and needle in name.casefold():
                    result["matches"].append(str(Path(directory) / name))
                    if len(result["matches"]) >= 60:
                        return {**result, "ok": True, "limited": True}
            if time.monotonic() >= deadline:
                return {**result, "ok": True, "timed_out": True}
        return {**result, "ok": True}
    except (OSError, ValueError, RuntimeError) as error:
        return {**result, "ok": False, "error": str(error)}


def emoji_search(query: str) -> int:
    query = query.casefold().strip()
    matches = []
    for start, end in ((0x1F600, 0x1F650), (0x1F300, 0x1F600), (0x1F650, 0x1FB00), (0x2600, 0x27C0)):
        for point in range(start, end):
            character = chr(point)
            name = unicodedata.name(character, "")
            if not name or name.startswith(("CJK", "SQUARED CJK")):
                continue
            if query and query not in name.casefold():
                continue
            matches.append({"character": character, "name": name.title()})
            if len(matches) == 60:
                print(json.dumps(matches, ensure_ascii=False))
                return 0
    print(json.dumps(matches, ensure_ascii=False))
    return 0


def calculate(expression: str) -> int:
    if not expression or len(expression) > 120:
        print("Enter a calculation")
        return 0
    try:
        result = subprocess.run(
            ["numbat", "--no-config", "--color", "never", "--pretty-print", "never", "-e", expression],
            capture_output=True, text=True, timeout=5, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        print("Calculator unavailable")
        return 1
    lines = [line.strip() for line in (result.stdout or result.stderr).splitlines() if line.strip()]
    print(lines[-1] if lines else "Invalid expression")
    return 0


def calculator_expression(expression: str, has_answer: bool) -> tuple[str, bool]:
    expression = expression.strip().translate(str.maketrans({"×": "*", "÷": "/", "−": "-"}))
    if not expression or len(expression) > 512 or "\n" in expression or "\r" in expression:
        raise ValueError("Enter a calculation of up to 512 characters")
    uses_answer = re.search(r"\b(?:ans|_)\b", expression, re.IGNORECASE) is not None
    if has_answer and not uses_answer and expression[0] in "+-*/^":
        expression = "ans " + expression
        uses_answer = True
    if uses_answer and not has_answer:
        raise ValueError("Calculate a result before using Ans")
    expression = re.sub(r"\b(?:ans|_)\b", "ans", expression, flags=re.IGNORECASE)
    number = r"(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?"
    relative = re.fullmatch(r"(.+?)\s*([+-])\s*(" + number + r")\s*%", expression)
    if relative and re.search(r"(?:\d|\.)[eE]$", relative.group(1).strip()):
        relative = None
    if relative:
        base, operation, percent = relative.groups()
        base, _ = calculator_expression(base, has_answer)
        expression = f"({base}) * (1 {operation} ({percent} / 100))"
    expression = re.sub(r"(?<![\w.])(" + number + r")\s*%", r"(\1 / 100)", expression)
    return expression, uses_answer


def calculate_json(request_text: str) -> int:
    try:
        request = json.loads(request_text)
        if not isinstance(request, dict) or not isinstance(request.get("expression"), str):
            raise ValueError("Enter a calculation")
        steps = request.get("steps", [])
        if not isinstance(steps, list) or len(steps) > 64 or any(not isinstance(step, str) or len(step) > 2048 for step in steps):
            raise ValueError("Invalid calculator memory")
        expression, continues = calculator_expression(request["expression"], bool(steps))
        steps = list(steps) if continues else []
        if len(steps) >= 64:
            raise ValueError("Start a new calculation with AC")
        steps.append(expression)
        command = ["numbat", "--no-config", "--no-init", "--color", "never", "--pretty-print", "never"]
        for step in steps:
            command.extend(["-e", step])
        command.extend(["-e", 'print("__SPECTRUM_RESULT__{ans:.12e}")'])
        result = subprocess.run(command, capture_output=True, text=True, timeout=5, check=False)
        if result.returncode:
            lines = [line.strip() for line in result.stderr.splitlines() if line.strip()]
            message = next((line for line in lines if line.lower().startswith("error")), "Invalid expression")
            raise ValueError(message[:240])
        prefix = "__SPECTRUM_RESULT__"
        lines = [line.strip()[len(prefix):] for line in result.stdout.splitlines() if line.strip().startswith(prefix)]
        if not lines:
            raise ValueError("Enter an expression that returns a result")
        value = lines[-1].strip()
        numeric = re.match(r"([+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)(.*)$", value)
        if numeric:
            number = Decimal(numeric.group(1)).normalize()
            text = format(number, "f") if number.is_zero() or -6 <= number.adjusted() < 15 else format(number, "E").replace("E", "e")
            value = text + numeric.group(2)
        print(json.dumps({"ok": True, "result": value, "steps": steps}))
        return 0
    except (ValueError, TypeError, OSError, subprocess.TimeoutExpired) as error:
        message = "Calculator unavailable" if isinstance(error, (OSError, subprocess.TimeoutExpired)) else str(error)
        print(json.dumps({"ok": False, "error": message}))
        return 1


def password(length: str, options: str) -> int:
    try:
        size = int(length)
    except ValueError:
        return 2
    if size < 8 or size > 128 or not options or any(option not in "lns" for option in options):
        return 2
    groups = {"l": string.ascii_letters, "n": string.digits, "s": "!@#$%_-+="}
    selected = [groups[key] for key in "lns" if key in options]
    characters = [secrets.choice(group) for group in selected]
    characters.extend(secrets.choice("".join(selected)) for _ in range(size - len(characters)))
    secrets.SystemRandom().shuffle(characters)
    print("".join(characters))
    return 0


def color_history_path() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "spectrumos" / "colors.json"


def questline_campaign_path() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "spectrumos" / "questline-campaign"


def questline_campaign(value: str | None = None) -> int:
    path = questline_campaign_path()
    if value is None:
        try:
            print(path.read_text(encoding="utf-8").strip())
        except OSError:
            print("")
        return 0
    if not value or len(value) > 128 or any(character.isspace() for character in value):
        return 2
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, prefix=".questline-campaign-", delete=False) as temporary:
        temporary.write(value + "\n")
        name = temporary.name
    os.replace(name, path)
    return 0


def color_history() -> list[str]:
    try:
        values = json.loads(color_history_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    if not isinstance(values, list):
        return []
    return [value.upper() for value in values if isinstance(value, str) and len(value) == 7 and value.startswith("#") and all(character in string.hexdigits for character in value[1:])][:COLOR_HISTORY_LIMIT]


def add_color(value: str) -> int:
    if len(value) != 7 or not value.startswith("#") or any(character not in string.hexdigits for character in value[1:]):
        return 2
    value = value.upper()
    colors = [value] + [color for color in color_history() if color != value]
    path = color_history_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_name = ""
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, prefix=".colors-", delete=False) as temporary:
            json.dump(colors[:COLOR_HISTORY_LIMIT], temporary)
            temporary_name = temporary.name
        os.replace(temporary_name, path)
    finally:
        if temporary_name and os.path.exists(temporary_name):
            os.unlink(temporary_name)
    print(json.dumps(colors[:5]))
    return 0


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] in ("search-state", "search-root", "search-json"):
        try:
            if sys.argv[1] == "search-state" and len(sys.argv) == 2:
                result = search_state()
            elif sys.argv[1] == "search-root" and len(sys.argv) == 3:
                result = search_state(sys.argv[2])
            elif sys.argv[1] == "search-json" and len(sys.argv) == 3:
                result = scoped_search(json.loads(sys.argv[2]))
            else:
                raise ValueError("Invalid search options.")
        except (OSError, ValueError, RuntimeError) as error:
            result = {"ok": False, "error": str(error)}
        print(json.dumps(result, ensure_ascii=False))
        return 0 if result["ok"] else 1
    if len(sys.argv) == 2 and sys.argv[1] == "questline-campaign":
        return questline_campaign()
    if len(sys.argv) == 3 and sys.argv[1] == "questline-campaign":
        return questline_campaign(sys.argv[2])
    if len(sys.argv) == 2 and sys.argv[1] == "colors":
        print(json.dumps(color_history()))
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == "color-add":
        return add_color(sys.argv[2])
    if len(sys.argv) == 3 and sys.argv[1] == "search":
        return search(sys.argv[2])
    if len(sys.argv) == 3 and sys.argv[1] == "emoji":
        return emoji_search(sys.argv[2])
    if len(sys.argv) == 3 and sys.argv[1] == "calculate-json":
        return calculate_json(sys.argv[2])
    if len(sys.argv) == 3 and sys.argv[1] == "calculate":
        return calculate(sys.argv[2])
    if len(sys.argv) == 4 and sys.argv[1] == "password":
        return password(sys.argv[2], sys.argv[3])
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
