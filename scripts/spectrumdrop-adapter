#!/usr/bin/env python3
import fcntl
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

CLI = '/usr/bin/spectrumdrop'
UNIT = 'spectrumdrop-send.service'
MAC = re.compile(r'(?:[0-9a-f]{2}:){5}[0-9a-f]{2}')


def runtime():
    base = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid()))) / 'spectrumdrop'
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    base.chmod(0o700)
    return base


def read_state(name):
    path = runtime() / (name + '.json')
    try:
        if path.stat().st_size > 8192:
            return {}
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def write_state(name, value):
    path = runtime() / (name + '.json')
    temporary = path.with_name(path.name + '.' + str(os.getpid()))
    with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as stream:
        json.dump(value, stream)
    os.replace(temporary, path)


def run(args, timeout=15, check=True):
    process = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               text=True, start_new_session=True)
    cancelled = False

    def stopping(number, frame):
        nonlocal cancelled
        cancelled = True
        if process.poll() is None:
            process.send_signal(signal.SIGTERM)

    previous = signal.signal(signal.SIGTERM, stopping)
    try:
        try:
            out, error = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            process.send_signal(signal.SIGTERM)
            try:
                process.communicate(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.communicate()
            raise ValueError('Operation timed out. Please retry.')
        if cancelled:
            raise SystemExit(143)
        if check and process.returncode:
            raise ValueError((error.strip() or out.strip() or 'Operation failed.')[-1000:])
        return out, process.returncode
    finally:
        signal.signal(signal.SIGTERM, previous)


def notify(message, failed=False):
    try:
        subprocess.run(['notify-send', '--app-name=SpectrumDrop', '-u', 'critical' if failed else 'normal',
                        'SpectrumDrop', message], timeout=5, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass


def peer(value):
    value = value.lower()
    if not MAC.fullmatch(value):
        raise ValueError('Select a valid nearby device.')
    return value


def normalize_peers(rows):
    result = {}
    if not isinstance(rows, list):
        raise ValueError('Invalid device discovery response.')
    for row in rows[:128]:
        try:
            address = peer(row['mac'])
            name = row.get('name')
            result[address] = dict(mac=address, name=str(name)[:160] if name else '', rssi=row.get('rssi'))
        except (KeyError, TypeError, ValueError):
            continue
    return list(result.values())


def status():
    if not Path(CLI).is_file():
        return dict(ok=True, available=False, receiving=False, visible=False, transfer={},
                    error='SpectrumDrop is unavailable. Update SpectrumOS to restore its components.')
    out, _ = run([CLI, 'status', '--json'], timeout=10)
    state = json.loads(out)
    transfer = read_state('transfer')
    if transfer.get('active'):
        _, active = run(['systemctl', '--user', 'is-active', UNIT], check=False)
        if active and time.time() - transfer.get('updated', 0) > 3:
            transfer.update(active=False, phase='failed', message='Send worker stopped unexpectedly.')
            write_state('transfer', transfer)
    return dict(ok=True, available=True, **state, transfer=transfer,
                radio_owned=bool(read_state('radio').get('restore_off')), error='')


def restore_radio():
    if read_state('radio').get('restore_off'):
        run(['nmcli', 'radio', 'wifi', 'off'])
        write_state('radio', {})


def receiving(minutes):
    if minutes not in ('5', '10', '30'):
        raise ValueError('Choose a 5, 10 or 30 minute receive window.')
    if read_state('transfer').get('active'):
        raise ValueError('Finish or cancel the current send before changing visibility.')
    before, _ = run(['nmcli', '-t', '-f', 'WIFI', 'radio'])
    if before.strip() == 'disabled':
        write_state('radio', dict(restore_off=True))
        run(['nmcli', 'radio', 'wifi', 'on'])
    try:
        run([CLI, 'on', minutes], timeout=60)
    except (ValueError, OSError):
        run([CLI, 'off', '--force'], timeout=20, check=False)
        restore_radio()
        raise
    notify('Receiving enabled for ' + minutes + ' minutes.')
    return status()


def send(address):
    address = peer(address)
    state = status()
    if not state.get('visible'):
        raise ValueError('Enable receiving and discovery before sending.')
    with open(runtime() / 'send.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        _, active = run(['systemctl', '--user', 'is-active', UNIT], check=False)
        if active == 0:
            raise ValueError('A transfer is already running.')
        write_state('transfer', dict(active=True, phase='choosing', peer=address,
                                    message='Choose files…', updated=time.time()))
        try:
            run(['systemd-run', '--user', '--quiet', '--collect', '--unit=' + UNIT,
                 '--property=Type=exec', '--property=TimeoutStopSec=12s',
                 '--property=KillMode=control-group', sys.argv[0], 'worker', address])
        except (OSError, ValueError):
            write_state('transfer', dict(active=False, phase='failed', message='Could not start sending.'))
            raise
    return status()


def worker(address):
    address = peer(address)
    cancelled = False
    process = None
    chosen = False
    state = dict(active=True, phase='choosing', peer=address, message='Choose files…', updated=time.time())

    def stopping(number, frame):
        nonlocal cancelled
        cancelled = True
        if process and process.poll() is None:
            process.send_signal(signal.SIGTERM)

    signal.signal(signal.SIGTERM, stopping)
    signal.signal(signal.SIGINT, stopping)
    write_state('transfer', state)
    try:
        process = subprocess.Popen([CLI, 'send', '--pick', '--to', address],
                                   stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in iter(lambda: process.stdout.readline(4096), ''):
            if not line.strip():
                continue
            if not chosen:
                notify('Sending files to the selected device…')
            chosen = True
            state.update(phase='sending', message=line.strip()[-512:], updated=time.time())
            write_state('transfer', state)
        code = process.wait()
        state['exit_code'] = code
        state['detail'] = state['message'] if chosen else ''
        if cancelled or (code == 1 and not chosen):
            state.update(phase='cancelled', message='Send cancelled.')
        elif code == 0:
            state.update(phase='complete', message='Files sent successfully.')
        else:
            detail = state['message'] if chosen else 'The sender returned no details.'
            if 'self-signed certificates' in detail:
                detail = 'Could not connect to the Mac’s AirDrop receiver. If Everyone is already enabled, reopen Finder → AirDrop, then Search and retry.'
            state.update(phase='failed', message='Send failed: ' + detail)
    except OSError:
        state.update(phase='failed', message='Send failed: Could not start the sender.')
    finally:
        if process and process.stdout:
            process.stdout.close()
        state.update(active=False, updated=time.time())
        write_state('transfer', state)
        if chosen or state['phase'] == 'failed':
            notify(state['message'], state['phase'] == 'failed')


def action(args):
    if not args:
        raise ValueError('Choose a SpectrumDrop action.')
    command = args[0]
    if command == 'status' and len(args) == 1:
        return status()
    if command == 'receive' and len(args) == 2:
        return receiving(args[1])
    if command == 'stop' and len(args) == 1:
        if read_state('transfer').get('active'):
            raise ValueError('Cancel the send before stopping discovery.')
        run([CLI, 'off'], timeout=25)
        restore_radio()
        notify('Receiving and discovery stopped.')
        return status()
    if command == 'scan' and len(args) == 1:
        out, code = run([CLI, 'peers', '-n', '--json'], timeout=45, check=False)
        if code not in (0, 1):
            raise ValueError('Discovery failed. Check receiving and radio availability.')
        return dict(ok=True, peers=normalize_peers(json.loads(out or '[]')))
    if command == 'send' and len(args) == 2:
        return send(args[1])
    if command == 'cancel' and len(args) == 1:
        run(['systemctl', '--user', 'stop', UNIT], timeout=20)
        return status()
    if command == 'folder' and len(args) == 1:
        run([CLI, 'dir', '--pick'], timeout=180)
        return status()
    raise ValueError('Unknown SpectrumDrop action.')


if __name__ == '__main__':
    if len(sys.argv) == 3 and sys.argv[1] == 'worker':
        worker(sys.argv[2])
    else:
        try:
            result = action(sys.argv[1:])
        except (OSError, ValueError, TypeError, subprocess.SubprocessError) as error:
            result = dict(ok=False, error=str(error)[-1000:])
            if sys.argv[1:2] not in (['status'], ['scan']):
                notify(result['error'], True)
        print(json.dumps(result), flush=True)
        sys.exit(0 if result.get('ok') else 1)
