#!/usr/bin/env bash
set -euo pipefail

database=$1
exclusions=$2
entry=$(bsdtar -tf "$database" | awk '/^spectrum-desktop-[^/]+\/desc$/ { print; exit }')
[[ -n $entry ]] || { printf 'The signed repository has no spectrum-desktop metadata.\n' >&2; exit 1; }
dependencies=$(bsdtar -xOf "$database" "$entry" | awk '/^%DEPENDS%$/ { active=1; next } /^%/ { active=0 } active && NF { print $1 }')
if printf '%s\n' "$dependencies" | grep -Fxf "$exclusions" >/dev/null; then
    printf 'The signed spectrum-desktop package still requires packages excluded by Lean mode. Publish an updated signed package before using this installer.\n' >&2
    exit 1
fi
