#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from pathlib import Path
import shutil
import tempfile


CONFIG_CANDIDATES = (
    Path("/boot/EFI/BOOT/limine.conf"),
    Path("/boot/limine/limine.conf"),
    Path("/boot/limine.conf"),
)


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Synchronize SpectrumOS appearance assets to Limine")
    parser.add_argument("--config", type=Path)
    parser.add_argument("--boot-root", type=Path, default=Path("/boot"))
    parser.add_argument("--appearance", type=Path, default=Path("/var/lib/spectrumos/appearance"))
    return parser.parse_args()


def replace_keys(content: str, values: dict[str, str | None]) -> str:
    lines: list[str] = []
    found: set[str] = set()
    for line in content.splitlines():
        key = line.split(":", 1)[0].strip().lower()
        if not line.lstrip().startswith(("/", "#")) and ":" in line and key in values:
            if values[key] is not None and key not in found:
                lines.append(f"{key}: {values[key]}")
                found.add(key)
        else:
            lines.append(line)
    missing = [f"{key}: {value}" for key, value in values.items() if key not in found and value is not None]
    if missing:
        insertion = next((index for index, line in enumerate(lines) if line.startswith("/")), len(lines))
        lines[insertion:insertion] = missing + [""]
    return "\n".join(lines).rstrip() + "\n"


def brand_entries(content: str) -> str:
    lines = content.splitlines()
    for index, line in enumerate(lines):
        if line == "/Arch Linux" or line.startswith("/Arch Linux "):
            lines[index] = "/SpectrumOS" + line.removeprefix("/Arch Linux")
    return "\n".join(lines).rstrip() + "\n"


def atomic_write(path: Path, content: str) -> None:
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as target:
            target.write(content)
            target.flush()
            os.fsync(target.fileno())
        os.chmod(temporary, path.stat().st_mode & 0o777)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main() -> int:
    options = arguments()
    config = options.config or next((path for path in CONFIG_CANDIDATES if path.is_file()), None)
    if config is None or not config.is_file():
        raise SystemExit("No Limine configuration was found")

    wallpaper = options.appearance / "current.png"
    colors_file = options.appearance / "colors.conf"
    if not wallpaper.is_file() or not colors_file.is_file():
        raise SystemExit("SpectrumOS shared wallpaper or colors are missing")

    destination = config.parent / "spectrumos-wallpaper.png"
    temporary = destination.with_name(f".{destination.name}.new")
    shutil.copyfile(wallpaper, temporary)
    os.chmod(temporary, 0o644)
    os.replace(temporary, destination)

    colors = dict(
        line.split("=", 1)
        for line in colors_file.read_text(encoding="utf-8").splitlines()
        if "=" in line
    )
    relative = destination.relative_to(options.boot_root)
    colors = {role: value.removeprefix("#") for role, value in colors.items()}
    # Limine invierte el texto seleccionado; los comentarios usan el color ANSI cian.
    palette = [colors[role] for role in (
        "background", "accent", "accent_alt", "accent", "accent_alt",
        "accent_alt", "accent_alt", "foreground",
    )]
    values = {
        "wallpaper": f"boot():/{relative}",
        "wallpaper_style": "stretched",
        "backdrop": colors["background"],
        "term_background": "cc" + colors["background"],
        "term_foreground": colors["accent"],
        "term_background_bright": colors["surface"],
        "term_foreground_bright": colors["accent_alt"],
        "term_palette": ";".join(palette),
        "term_palette_bright": ";".join([colors["surface"], *palette[1:]]),
        "interface_branding_colour": colors["accent_alt"],
        "interface_help_colour": colors["muted"],
        "interface_help_colour_bright": colors["accent"],
        "interface_branding_color": None,
        "interface_help_color": None,
        "interface_help_color_bright": None,
        "menu_background": None,
        "menu_foreground": None,
        "menu_highlight_background": None,
        "menu_highlight_foreground": None,
    }
    backup = config.with_suffix(config.suffix + ".spectrumos-backup")
    if not backup.exists():
        shutil.copy2(config, backup)
    updated = replace_keys(config.read_text(encoding="utf-8"), values)
    atomic_write(config, brand_entries(updated))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
