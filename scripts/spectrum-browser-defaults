#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import tempfile


BROWSERS = ("opt/google/chrome/chrome", "opt/brave-bin/brave")


def configure(root: Path) -> None:
    for executable in BROWSERS:
        binary = root / executable
        if not binary.is_file():
            continue
        path = binary.parent / "initial_preferences"
        legacy = binary.parent / "master_preferences"
        if not path.exists() and not path.is_symlink() and legacy.exists():
            path = legacy
        if path.is_symlink():
            raise RuntimeError(f"Cannot adopt symlinked browser defaults: {path}")
        data = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
        theme = data.setdefault("extensions", {}).setdefault("theme", {})
        if "system_theme" in theme:
            continue
        # Chromium guarda GTK como 1; estos valores sólo se copian al crear el perfil.
        theme["system_theme"] = 1
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False) as handle:
                temporary = Path(handle.name)
                json.dump(data, handle, indent=2)
                handle.write("\n")
            os.chmod(temporary, path.stat().st_mode & 0o777 if path.exists() else 0o644)
            os.replace(temporary, path)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)
        print(f"Configured GTK for new browser profiles: {path}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Set GTK appearance defaults for new Chrome and Brave profiles")
    parser.add_argument("--root", type=Path, default=Path("/"))
    try:
        configure(parser.parse_args().root.resolve())
    except (OSError, ValueError, TypeError, AttributeError, RuntimeError) as error:
        parser.exit(1, f"Could not configure browser appearance defaults: {error}\n")
