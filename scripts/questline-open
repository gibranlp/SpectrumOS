#!/usr/bin/env bash
set -euo pipefail

if [[ -f ${HOME}/.local/bin/questline && -x ${HOME}/.local/bin/questline ]]; then
    questline_binary=${HOME}/.local/bin/questline
elif command -v questline >/dev/null 2>&1; then
    questline_binary=$(command -v questline)
else
    printf 'Questline is not installed.\n' >&2
    exit 1
fi

exec kitty --class questline -e "$questline_binary"
