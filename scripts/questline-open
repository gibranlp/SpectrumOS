#!/usr/bin/env bash
set -euo pipefail

questline_binary=${SPECTRUM_QUESTLINE_BINARY:-/usr/bin/questline}
if [[ ! -f $questline_binary || ! -x $questline_binary ]]; then
    printf 'Questline is not installed.\n' >&2
    exit 1
fi

systemctl --user --no-block start spectrum-questline-notifications.service spectrum-questline-sync.service || true

exec ghostty --class=com.spectrumos.questline -e "$questline_binary"
