#!/usr/bin/env python
"""Performance/Balanced power profile toggle, backed by whichever profile daemon the
active form factor actually installs: `power-profiles-daemon` (laptop) or `tuned`
(desktop, per bootstrap/packages/form-factor and desktop.txt) -- never both, so the two
never fight over the same knob. Manual control is a single toggle (the Eww header icon,
or `--set MODE`); automatic control comes from GameMode's `[custom]` start/end hooks
(wired by appearance-sync's `ensure_gamemode_hook`), which call `--game-start`/`--game-end`
for *any* game that already integrates with GameMode -- the vast majority of Steam/Proton
titles out of the box, without SpectrumOS needing to recognize individual games itself.
"""
from __future__ import annotations

import json
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time


STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "spectrumos/performance-mode"
PRE_GAME_FILE = STATE_DIR / "pre-game-mode"
GAME_COUNT_FILE = STATE_DIR / "game-count"

# "Performance" maps to a real tuned profile name; "balanced" is tuned's own profile of
# that exact name, so both directions are a plain, unambiguous `tuned-adm profile <name>`.
TUNED_PROFILES = {"performance": "throughput-performance", "balanced": "balanced", "power-saver": "powersave"}
MODES = ("power-saver", "balanced", "performance")

# TuneD keeps the active profile's name in this plain file too, updated whenever
# `tuned-adm profile <name>` changes it -- reading it directly is a fast path around
# `tuned-adm active` below, which is TuneD's own Python CLI making a full D-Bus round
# trip to the system daemon just to report one string (measured well over 100ms on this
# machine). This runs from `system-adapter`'s 5s Control Center poll, so that cost was
# repeating the whole time the panel stayed open.
TUNED_ACTIVE_PROFILE_FILE = Path("/etc/tuned/active_profile")


def run(*arguments: str, timeout: float = 3) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(arguments, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return subprocess.CompletedProcess(arguments, 1, "", "")


def backend() -> str:
    if shutil.which("powerprofilesctl") and run("systemctl", "is-active", "power-profiles-daemon.service").returncode == 0:
        return "power-profiles-daemon"
    if shutil.which("tuned-adm") and run("systemctl", "is-active", "tuned.service").returncode == 0:
        return "tuned"
    return "none"


def tuned_active_profile() -> str:
    # Only fall back to the slow `tuned-adm active` D-Bus round trip if the state file is
    # missing, empty, or unreadable -- e.g. an unusual TuneD build that doesn't write it.
    try:
        name = TUNED_ACTIVE_PROFILE_FILE.read_text(encoding="utf-8").strip()
        if name:
            return name
    except OSError:
        pass
    for line in run("tuned-adm", "active").stdout.splitlines():
        if line.startswith("Current active profile:"):
            return line.split(":", 1)[1].strip()
    return ""


def current_mode(active_backend: str) -> str:
    if active_backend == "power-profiles-daemon":
        value = run("powerprofilesctl", "get").stdout.strip()
        return value if value in MODES else "balanced"
    if active_backend == "tuned":
        profile = tuned_active_profile()
        return next((mode for mode, name in TUNED_PROFILES.items() if name == profile), "balanced")
    return "balanced"


def available_modes(active_backend: str) -> list[str]:
    if active_backend == "power-profiles-daemon":
        names = {line.strip().lstrip("* ").rstrip(":") for line in run("powerprofilesctl", "list").stdout.splitlines()}
        return [mode for mode in MODES if mode in names] or ["power-saver", "balanced"]
    return list(MODES) if active_backend == "tuned" else []


def set_mode(mode: str, active_backend: str) -> bool:
    if mode not in MODES:
        return False
    if active_backend == "power-profiles-daemon":
        success = run("powerprofilesctl", "set", mode).returncode == 0
    elif active_backend == "tuned":
        success = run("tuned-adm", "profile", TUNED_PROFILES[mode]).returncode == 0
    else:
        return False
    if success:
        try:
            (STATE_DIR / "status-cache.json").unlink(missing_ok=True)
        except OSError:
            pass
    return success


def notify(mode: str) -> None:
    # Always frames the mode that just turned on -- there is deliberately no matching
    # "deactivated" notification for the one it replaced (every switch is already
    # unambiguous with just one toast, and a pair would double up for no added information).
    label = {"performance": "Performance", "balanced": "Balanced", "power-saver": "Power saving"}[mode]
    run("notify-send", "--app-name=SpectrumOS", "--expire-time=2000", f"{label} mode activated")


def snapshot() -> dict:
    cache = STATE_DIR / "status-cache.json"
    now = time.monotonic()
    try:
        cached = json.loads(cache.read_text())
        if 0 <= now - cached["updated"] < 30 and isinstance(cached["state"], dict):
            return cached["state"]
    except (OSError, ValueError, KeyError, TypeError):
        pass
    active_backend = backend()
    state = {
        "available": active_backend != "none",
        "backend": active_backend,
        "mode": current_mode(active_backend) if active_backend != "none" else "balanced",
        "modes": available_modes(active_backend),
    }
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        temporary = cache.with_name(f".status-cache-{os.getpid()}.tmp")
        temporary.write_text(json.dumps({"updated": now, "state": state}))
        os.replace(temporary, cache)
    except OSError:
        pass
    return state


def print_json() -> None:
    print(json.dumps(snapshot()))


def print_status() -> None:
    # Waybar's own custom-module shape (text/tooltip/class), distinct from --json above
    # (what the Eww header icon polls). Empty text plus Waybar's hide-empty-text on this
    # module is what hides it entirely on a form factor with neither backend, rather than
    # showing a dead button. Same md-speedometer/fa-scale_balanced glyphs as the Eww header
    # icon, verified present in every Nerd Font family SpectrumOS offers.
    active_backend = backend()
    if active_backend == "none":
        print(json.dumps({"text": "", "tooltip": "", "class": "unavailable"}))
        return
    mode = current_mode(active_backend)
    text = {"performance": "\U000f04c5", "balanced": "\U0000f24e", "power-saver": "\U000f032a"}[mode]
    tooltip = {"performance": "Performance mode", "balanced": "Balanced mode", "power-saver": "Power saving mode"}[mode]
    print(json.dumps({"text": text, "tooltip": f"{tooltip}\nClick to toggle", "class": mode}))


def toggle() -> int:
    active_backend = backend()
    if active_backend == "none":
        return 1
    modes = available_modes(active_backend)
    current = current_mode(active_backend)
    new_mode = modes[(modes.index(current) + 1) % len(modes)] if current in modes else "balanced"
    if not set_mode(new_mode, active_backend):
        return 1
    notify(new_mode)
    return 0


def set_command(mode: str) -> int:
    active_backend = backend()
    if active_backend == "none" or mode not in MODES:
        return 1
    if not set_mode(mode, active_backend):
        return 1
    notify(mode)
    return 0


def _read_count() -> int:
    try:
        return max(0, int(GAME_COUNT_FILE.read_text(encoding="utf-8").strip()))
    except (OSError, ValueError):
        return 0


def _write_count(value: int) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    temporary = GAME_COUNT_FILE.with_name(f".{GAME_COUNT_FILE.name}.tmp")
    temporary.write_text(str(value), encoding="utf-8")
    os.replace(temporary, GAME_COUNT_FILE)


def game_start() -> int:
    # A count, not a flag: GameMode's start/end hooks fire per client process, and more
    # than one game (or a game plus another GameMode-aware app) can overlap. Only the
    # first arrival remembers the pre-game mode and switches; only the last departure
    # restores it, so a second game ending doesn't undo the first game's own restore.
    active_backend = backend()
    if active_backend == "none":
        return 0
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    count = _read_count()
    if count == 0:
        current = current_mode(active_backend)
        PRE_GAME_FILE.write_text(current, encoding="utf-8")
        # Only announce it if this game launch is actually the thing turning Performance
        # on -- not if it was already active (manually, or from an earlier overlapping
        # game), which would just repeat a toast for no real change.
        if current != "performance" and set_mode("performance", active_backend):
            notify("performance")
    _write_count(count + 1)
    return 0


def game_end() -> int:
    active_backend = backend()
    if active_backend == "none":
        return 0
    count = max(0, _read_count() - 1)
    _write_count(count)
    if count == 0:
        try:
            previous = PRE_GAME_FILE.read_text(encoding="utf-8").strip()
        except OSError:
            previous = "balanced"
        previous = previous if previous in MODES else "balanced"
        # Same rule as game_start: only announce the restore if it's an actual change --
        # e.g. not if the mode was already manually switched back while the game was
        # still running, which would make this restore a no-op.
        if current_mode(active_backend) != previous and set_mode(previous, active_backend):
            notify(previous)
    return 0


def main() -> int:
    arguments = sys.argv[1:]
    if arguments == ["--json"]:
        print_json()
        return 0
    if arguments == ["--status"]:
        print_status()
        return 0
    if arguments == ["--toggle"]:
        return toggle()
    if len(arguments) == 2 and arguments[0] == "--set":
        return set_command(arguments[1])
    if arguments in (["--game-start"], ["--game-end"]):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        # Los hooks de GameMode y el perfil Gaming pueden llegar al mismo tiempo.
        with (STATE_DIR / "game.lock").open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            return game_start() if arguments == ["--game-start"] else game_end()
    print("Usage: performance-mode --json|--status|--toggle|--set MODE|--game-start|--game-end", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
