#!/usr/bin/env python3
from __future__ import annotations

import argparse
import colorsys
from math import cos, hypot, pi, sin
from pathlib import Path

CASES = ('colorful', 'blue', 'red-orange', 'near-monochrome', 'dark', 'bright',
         'low-saturation', 'small-vivid-focal', 'many-colors')


def make_pixels(name: str, width: int = 128, height: int = 80) -> list[tuple[int, int, int]]:
    pixels = []
    for y in range(height):
        for x in range(width):
            u, v = x / width, y / height
            wave = 0.5 + 0.5 * sin(8 * u + 5 * v)
            if name == 'colorful':
                hue, saturation, lightness = (u + 0.3 * v) % 1, 0.85, 0.25 + 0.35 * wave
            elif name == 'blue':
                hue, saturation, lightness = 0.57 + 0.10 * u, 0.65 + 0.2 * v, 0.16 + 0.5 * wave
            elif name == 'red-orange':
                hue, saturation, lightness = 0.01 + 0.10 * u, 0.65 + 0.25 * v, 0.20 + 0.45 * wave
            elif name == 'near-monochrome':
                hue, saturation, lightness = 0.60, 0.025, 0.15 + 0.65 * wave
            elif name == 'dark':
                hue, saturation, lightness = 0.58 + 0.10 * u, 0.5, 0.025 + 0.11 * wave
                if hypot(u - 0.55, v - 0.45) < 0.14:
                    hue, saturation, lightness = 0.07, 0.8, 0.38
            elif name == 'bright':
                hue, saturation, lightness = 0.09 + 0.45 * u, 0.5, 0.78 + 0.15 * wave
            elif name == 'low-saturation':
                hue, saturation, lightness = 0.35 + 0.40 * u, 0.09 + 0.06 * v, 0.22 + 0.48 * wave
            elif name == 'small-vivid-focal':
                hue, saturation, lightness = 0.60, 0.12, 0.16 + 0.18 * wave
                if hypot(u - 0.5, (v - 0.5) * 0.625) < 0.055:
                    hue, saturation, lightness = 0.055, 0.95, 0.55
            elif name == 'many-colors':
                hue = ((x * 13 // width) * 0.137 + (y * 8 // height) * 0.239) % 1
                saturation, lightness = 0.6 + 0.25 * wave, 0.18 + 0.52 * (0.5 + 0.5 * cos(u * 3 * pi - v))
            else:
                raise ValueError(f'Unknown fixture: {name}')
            pixels.append(tuple(round(channel * 255) for channel in colorsys.hls_to_rgb(hue, lightness, saturation)))
    return pixels


def main():
    parser = argparse.ArgumentParser(description='Create nine deterministic palette diagnostic wallpapers')
    parser.add_argument('output', type=Path)
    arguments = parser.parse_args()
    arguments.output.mkdir(parents=True, exist_ok=True)
    for name in CASES:
        pixels = make_pixels(name)
        (arguments.output / f'{name}.ppm').write_bytes(b'P6\n128 80\n255\n' +
            bytes(channel for color in pixels for channel in color))
    print(f'Created {len(CASES)} diagnostic wallpapers in {arguments.output}')


if __name__ == '__main__':
    main()
