#!/usr/bin/env python3
from __future__ import annotations

import colorsys
import fcntl
import json
import os
from pathlib import Path
import re
import select
import sys
import time


HIDRAW = Path('/sys/class/hidraw')
DEV = Path('/dev')
CACHE = Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache'))
CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
CURRENT = CACHE / 'spectrumos/theme/current'
RAW_DESCRIPTOR = bytes.fromhex('0660ff0961a1010962150026ff009520750881020963150026ff00952075089102c0')


def devices() -> list[Path]:
    found = []
    for node in sorted(HIDRAW.glob('hidraw*')):
        try:
            values = dict(line.split('=', 1) for line in (node / 'device/uevent').read_text().splitlines() if '=' in line)
            if (values.get('HID_ID', '').upper() == '0003:00003434:000001E0'
                    and (node / 'device/report_descriptor').read_bytes() == RAW_DESCRIPTOR):
                found.append(DEV / node.name)
        except OSError:
            continue
    return found


def command(fd: int, payload: bytes) -> bytes:
    os.write(fd, b'\0' + payload.ljust(32, b'\0'))
    deadline = time.monotonic() + 0.25
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
            raise TimeoutError('Q11 VIA response timed out')
        response = os.read(fd, 32)
        if len(response) != 32:
            raise ValueError('Invalid Q11 VIA response size')
        if response[0] == 0xff:
            raise ValueError('Q11 firmware does not support this VIA lighting command')
        prefix = payload[:3] if payload[0] in (7, 8) else payload[:1]
        if response.startswith(prefix):
            return response


def state(fd: int) -> dict:
    protocol = int.from_bytes(command(fd, b'\x01')[1:3], 'big')
    if protocol != 11:
        raise ValueError(f'Unsupported Q11 VIA protocol: {protocol}; expected 11')
    brightness = command(fd, bytes([8, 3, 1]))[3]
    effect = command(fd, bytes([8, 3, 2]))[3]
    color = command(fd, bytes([8, 3, 4]))[3:5]
    return {'protocol': protocol, 'brightness': brightness, 'effect': effect,
            'hue': color[0], 'saturation': color[1]}


def accent() -> bytes:
    value = json.loads((CURRENT / 'palette.json').read_text())['roles']['accent']
    if not isinstance(value, str) or not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
        raise ValueError('Invalid lighting palette color')
    red, green, blue = bytes.fromhex(value[1:])
    hue, saturation, _ = colorsys.rgb_to_hsv(red / 255, green / 255, blue / 255)
    return bytes([round(hue * 255), round(saturation * 255)])


def apply() -> bool:
    if (CONFIG / 'spectrumos/keychron-rgb.disabled').exists():
        return False
    nodes = devices()
    if not nodes:
        return False
    directory = CACHE / 'spectrumos/theme'
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / 'keychron-rgb.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        color = accent()
        for node in nodes:
            fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
            try:
                current = state(fd)
                if bytes([current['hue'], current['saturation']]) != color:
                    command(fd, bytes([7, 3, 4]) + color)
                # El efecto cero significa apagado; no lo prendemos al cambiar el tema.
                if current['effect'] not in (0, 1):
                    command(fd, bytes([7, 3, 2, 1]))
            finally:
                os.close(fd)
    return True


def main() -> int:
    try:
        if sys.argv[1:] == ['--status']:
            found = []
            for node in devices():
                item = {'device': str(node), 'writable': os.access(node, os.R_OK | os.W_OK)}
                if item['writable']:
                    fd = os.open(node, os.O_RDWR | os.O_NONBLOCK)
                    try:
                        item.update(state(fd))
                    finally:
                        os.close(fd)
                found.append(item)
            print(json.dumps({'devices': found, 'enabled': not (CONFIG / 'spectrumos/keychron-rgb.disabled').exists()}))
        elif not sys.argv[1:] or sys.argv[1:] == ['--apply']:
            apply()
        else:
            print('Usage: keychron-rgb-sync [--apply|--status]', file=sys.stderr)
            return 2
        return 0
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f'Keychron RGB sync: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
