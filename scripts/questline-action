#!/usr/bin/env python3
import json
import os
from pathlib import Path
import subprocess
import sys


def main():
    if len(sys.argv) != 2:
        print(json.dumps({"error": "Missing Questline action"}))
        return 2
    binary = os.environ.get("SPECTRUM_QUESTLINE_BINARY") or "/usr/bin/questline"
    if not (Path(binary).is_file() and os.access(binary, os.X_OK)):
        print(json.dumps({"error": "Questline is not installed"}))
        return 1
    try:
        request = json.loads(sys.argv[1])
        if not isinstance(request, dict):
            raise ValueError("Action must be an object")
        result = subprocess.run([binary, "shell-action", json.dumps(request)], capture_output=True, text=True, timeout=20)
        if result.returncode:
            message = result.stderr.strip().removeprefix("Error: ") or "Questline action failed"
            print(json.dumps({"error": message}))
            return 1
        print(result.stdout.strip())
        return 0
    except (ValueError, subprocess.TimeoutExpired) as error:
        print(json.dumps({"error": str(error)}))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
