#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
    printf 'Usage: %s WALLPAPER\n' "$0" >&2
    exit 2
fi

wallpaper=$(realpath -- "$1")
appearance_dir=${SPECTRUM_APPEARANCE_DIR:-/var/lib/spectrumos/appearance}
palette=${SPECTRUM_PALETTE:-${XDG_CACHE_HOME:-$HOME/.cache}/spectrumos/theme/current/palette.json}

[[ -f $wallpaper ]] || { printf 'Wallpaper not found: %s\n' "$wallpaper" >&2; exit 1; }
[[ -r $palette ]] || { printf 'Active Spectrum palette not found: %s\n' "$palette" >&2; exit 1; }
[[ -w $appearance_dir ]] || {
    printf 'Spectrum appearance handoff is not writable; log out once after installation to refresh group membership.\n' >&2
    exit 1
}

wallpaper_staging=$(mktemp --tmpdir="$appearance_dir" .wallpaper.XXXXXX.png)
colors_staging=$(mktemp --tmpdir="$appearance_dir" .colors.XXXXXX.conf)
logo_svg_staging=$(mktemp --tmpdir="$appearance_dir" .logo.XXXXXX.svg)
logo_png_staging=$(mktemp --tmpdir="$appearance_dir" .logo.XXXXXX.png)
wordmark_template=${SPECTRUM_WORDMARK_TEMPLATE:-/usr/share/spectrumos/branding/spectrum-wordmark.svg}
wordmark_svg_staging=$(mktemp --tmpdir="$appearance_dir" .wordmark.XXXXXX.svg)
wordmark_png_staging=$(mktemp --tmpdir="$appearance_dir" .wordmark.XXXXXX.png)
lock_branding_staging=$(mktemp --tmpdir="$appearance_dir" .lock-branding.XXXXXX.png)
trap 'rm -f -- "$wallpaper_staging" "$colors_staging" "$logo_svg_staging" "$logo_png_staging" "$wordmark_svg_staging" "$wordmark_png_staging" "$lock_branding_staging"' EXIT

ffmpeg -hide_banner -loglevel error -y -i "$wallpaper" -frames:v 1 "$wallpaper_staging"
python - "$palette" "$colors_staging" "$logo_svg_staging" "$wordmark_template" "$wordmark_svg_staging" <<'PY'
import json
from pathlib import Path
import sys
import xml.etree.ElementTree as ET

roles = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))["roles"]
wanted = ("background", "surface", "foreground", "muted", "accent", "accent_alt")
Path(sys.argv[2]).write_text(
    "".join(f"{role}={roles[role]}\n" for role in wanted),
    encoding="utf-8",
)

def mix(first: str, second: str, amount: float) -> str:
    left = tuple(int(first[index:index + 2], 16) for index in (1, 3, 5))
    right = tuple(int(second[index:index + 2], 16) for index in (1, 3, 5))
    values = tuple(round(a + (b - a) * amount) for a, b in zip(left, right))
    return "#" + "".join(f"{value:02x}" for value in values)

accent = roles["accent"]
alternate = roles["accent_alt"]
layers = (
    mix(roles["background"], accent, 0.22),
    mix(roles["background"], accent, 0.55),
    accent,
    mix(accent, alternate, 0.34),
    mix(accent, alternate, 0.67),
    alternate,
    mix(alternate, roles["foreground"], 0.42),
    "#ffffff",
)
path = "M31.994-.006c-2.85 6.985-4.568 11.554-7.74 18.332 1.945 2.062 4.332 4.462 8.2 7.174-4.168-1.715-7-3.437-9.136-5.224-4.06 8.47-10.42 20.538-23.327 43.73C10.145 58.15 18 54.54 25.338 53.16c-.315-1.354-.494-2.818-.48-4.345l.012-.325c.16-6.5 3.542-11.498 7.547-11.158s7.118 5.886 6.957 12.386a18.36 18.36 0 0 1-.409 3.491c7.25 1.418 15.03 5.02 25.037 10.797l-5.42-10.026c-2.65-2.053-5.413-4.726-11.05-7.62 3.875 1.007 6.65 2.168 8.8 3.467-17.1-31.84-18.486-36.07-24.35-49.833z"
shapes = "\n".join(
    f'  <path d="{path}" fill="{color}" transform="translate({20 + index * 2} {13 + index}) scale(3.5)"/>'
    for index, color in enumerate(layers)
)
Path(sys.argv[3]).write_text(
    f'<svg xmlns="http://www.w3.org/2000/svg" width="278" height="250" viewBox="0 0 278 250">\n{shapes}\n</svg>\n',
    encoding="utf-8",
)
ET.register_namespace("", "http://www.w3.org/2000/svg")
wordmark = ET.parse(sys.argv[4])
for shape in wordmark.getroot().iter():
    layer = shape.attrib.pop("data-spectrum-layer", None)
    if layer is not None:
        shape.set("fill", layers[int(layer)])
wordmark.write(sys.argv[5], encoding="utf-8", xml_declaration=True)
PY
ffmpeg -hide_banner -loglevel error -y -i "$logo_svg_staging" -frames:v 1 "$logo_png_staging"
ffmpeg -hide_banner -loglevel error -y -i "$wordmark_svg_staging" -frames:v 1 "$wordmark_png_staging"
# El lienzo compartido mantiene juntas las dos marcas en pantallas de distinta altura.
ffmpeg -hide_banner -loglevel error -y -i "$logo_png_staging" -i "$wordmark_png_staging" \
    -filter_complex '[0:v]pad=278:346:0:0:color=0x00000000[logo];[1:v]scale=250:84[wordmark];[logo][wordmark]overlay=14:250:format=auto' \
    -frames:v 1 "$lock_branding_staging"
chmod 0644 "$wordmark_svg_staging" "$wordmark_png_staging" "$lock_branding_staging"
chmod 0644 "$wallpaper_staging" "$colors_staging" "$logo_svg_staging" "$logo_png_staging"
mv -f -- "$wallpaper_staging" "$appearance_dir/current.png"
mv -f -- "$colors_staging" "$appearance_dir/colors.conf"
mv -f -- "$logo_svg_staging" "$appearance_dir/logo.svg"
mv -f -- "$logo_png_staging" "$appearance_dir/logo.png"
mv -f -- "$wordmark_svg_staging" "$appearance_dir/wordmark.svg"
mv -f -- "$wordmark_png_staging" "$appearance_dir/wordmark.png"
mv -f -- "$lock_branding_staging" "$appearance_dir/lock-branding.png"
username=$(id -un)
user_picture="$HOME/$username.png"
if [[ -r $user_picture ]]; then
    avatar_staging=$(mktemp --tmpdir="$appearance_dir" .avatar.XXXXXX.png)
    if ffmpeg -hide_banner -loglevel error -y -i "$user_picture" -vf 'scale=256:256:force_original_aspect_ratio=increase,crop=256:256' -frames:v 1 "$avatar_staging"; then
        chmod 0644 "$avatar_staging"
        mv -f -- "$avatar_staging" "$appearance_dir/$username.png"
    else
        rm -f -- "$avatar_staging"
    fi
else
    rm -f -- "$appearance_dir/$username.png"
fi
touch "$appearance_dir/request"
