#!/usr/bin/env python3
import json
import os
from pathlib import Path
import runpy
import socket
import sys


def notify(data, timeout=86400):
    backend = runpy.run_path(str(Path(__file__).with_name('app-store-adapter')))
    path = backend['socket_path'](os.environ.get('SPECTRUM_APP_STORE_JOB'))
    client = socket.socket(socket.AF_UNIX)
    client.settimeout(timeout)
    client.connect(str(path))
    with client, client.makefile('rwb') as stream:
        stream.write(json.dumps(data).encode()+b'\n')
        stream.flush()
        result = json.loads(stream.readline(1_000_000))
    if not result.get('ok'):
        raise ValueError(result.get('error') or 'AUR review was declined.')


if __name__ == '__main__':
    try:
        args = sys.argv[1:]
        if len(args) == 1 and Path(args[0]).is_dir():
            notify(dict(action='review', directory=str(Path(args[0]).resolve())))
        elif args and args[0] in ('/usr/bin/pacman', 'pacman'):
            helper = runpy.run_path(str(Path(__file__).with_name('app-store-privileged')))
            helper['bridge_arguments'](args[1:])
            notify(dict(action='authentication'), timeout=10)
            os.execv('/usr/bin/pkexec', ['pkexec', '--disable-internal-agent', '/usr/lib/spectrumos/app-store-privileged', 'bridge', *args[1:]])
        else:
            raise ValueError('Unsupported Paru privilege or review request.')
    except Exception as error:
        print('App Store: '+str(error), file=sys.stderr)
        sys.exit(1)
