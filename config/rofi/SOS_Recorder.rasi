/*****----- Global Properties -----*****/
@import "~/.cache/wal/SOS_Colors.rasi" 

/*****----- Main Window -----*****/
window {
    location:                    northwest;
    margin:                      5px;
    fullscreen:                  false;
    width:                       25%;
    height:                      100%;
    border-radius:               2px;
    enabled:                     true;
    cursor:                      "default";
    background-color:            @background;
    padding:                     4px;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     100px 20px;
    background-color:            transparent;
    background-image:            url("/var/lib/spectrumos/current.png", width);
    text-color:                  @background;
    orientation:                 horizontal;
    children:                    ["prompt"];
    border-radius:               0px;
}

prompt {
    padding:                     12px 16px;    
    border-radius:               2px;
    background-color:            @background;
    text-color:                  @color1;
    horizontal-align:            0.5;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     10px;
    padding:                     10px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     12px;
    border-radius:               2px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}
element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}
element selected.normal {
    background-color:            @color3;
    text-color:                  @background;
}
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0;
}
