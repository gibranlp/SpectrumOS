#!/usr/bin/env bash
set -euo pipefail
project=${1:?Usage: install PROJECT DESTDIR}
destination=${2:?Usage: install PROJECT DESTDIR}
install -d -m 0755 "$destination/usr/share/spectrumos/spectrum-ukvm" "$destination/usr/lib/spectrumos" "$destination/usr/bin" "$destination/usr/share/applications" "$destination/usr/share/doc/spectrum-desktop"
install -m 0644 "$project"/configs/spectrum-ukvm/*.qml "$project"/configs/spectrum-ukvm/*.js "$destination/usr/share/spectrumos/spectrum-ukvm/"
frame="$destination/usr/share/spectrumos/spectrum-ukvm/frame"
install -d -m 0755 "$frame"
for component in ShellSurface ShellMotion ShellCorner ShellGeometry KeyboardNavigation; do
    install -m 0644 "$project/configs/spectrum-shell/$component.qml" "$frame/"
done
sed 's@import "../spectrum-shell" as Shell@import "frame" as Shell@' \
    "$project/configs/spectrum-ukvm/shell.qml" > "$destination/usr/share/spectrumos/spectrum-ukvm/shell.qml"
install -m 0755 "$project/scripts/ukvm-adapter" "$destination/usr/lib/spectrumos/ukvm-adapter"
install -m 0755 "$project/scripts/spectrum-ukvm" "$destination/usr/bin/spectrum-ukvm"
install -m 0644 "$project/integrations/ukvm/spectrum-ukvm.desktop" "$destination/usr/share/applications/spectrum-ukvm.desktop"
install -m 0644 "$project/docs/ukvm-integration.md" "$destination/usr/share/doc/spectrum-desktop/ukvm-integration.md"
install -m 0644 "$project/docs/ukvm-production.md" "$destination/usr/share/doc/spectrum-desktop/ukvm-production.md"
