    def load_disks(self):
        try:
            output = subprocess.check_output([BACKEND, "--list-disks", "--json"], text=True)
            self.disks = json.loads(output)
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            self.disks = []

    def connected(self):
        try:
            state = subprocess.check_output(
                ["nmcli", "--terse", "--fields", "STATE", "general"],
                text=True,
                timeout=3,
            ).strip().lower()
        except (OSError, subprocess.SubprocessError):
            return False
        return state.startswith("connected")

    def refresh_network_status(self):
        online = self.connected()
        self.network_status.set_text(
            "Network connected · internet is required" if online
            else "Connect to Wi-Fi or Ethernet before installing"
        )
        return True

    def keyboard_changed(self, _dropdown, _parameter):
        profile = self.keyboard_profiles[self.keyboard.get_selected()]
        if profile == "us-intl":
            layouts, variants, options = "us", "intl", ""
        elif profile == "us-intl,latam":
            layouts, variants, options = "us,latam", "intl,", "grp:alt_shift_toggle"
        elif profile == "us-intl,es":
            layouts, variants, options = "us,es", "intl,", "grp:alt_shift_toggle"
        else:
            layouts, variants = profile, ""
            options = "grp:alt_shift_toggle" if "," in profile else ""
        for key, value in (
            ("input:kb_layout", layouts),
            ("input:kb_variant", variants),
            ("input:kb_options", options),
        ):
            subprocess.run(["hyprctl", "keyword", key, value], check=False)

    @staticmethod
    def disk_label(item):
        size = int(item.get("size") or 0) / (1024**3)
        model = (item.get("model") or "Disk").strip()
        transport = (item.get("tran") or "").upper()
        return f"{model} · {size:.1f} GiB · {item['path']} {transport}".strip()

    @staticmethod
    def detect_gpu():
        try:
            output = subprocess.check_output(["lspci"], text=True).lower()
        except (OSError, subprocess.SubprocessError):
            return 1
        controllers = "\n".join(
            line for line in output.splitlines()
            if any(kind in line for kind in ("vga compatible controller", "3d controller", "display controller"))
        )
        if any(name in controllers for name in ("virtio", "vmware", "virtualbox")):
            return 5
        has_nvidia = "nvidia" in controllers
        has_intel = "intel" in controllers
        has_amd = "amd" in controllers or "ati" in controllers
        if has_nvidia and has_intel:
            return 3
        if has_nvidia and has_amd:
            return 4
        if has_nvidia:
            return 2
        if has_amd:
            return 0
        return 1

    @staticmethod
    def detect_cpu():
        value = Path("/proc/cpuinfo").read_text(encoding="utf-8", errors="ignore").lower()
        return "amd" if "authenticamd" in value else "intel"

    def selected_browsers(self):
        return [
            name for name, button in (
                ("chrome", self.browser_chrome),
                ("brave", self.browser_brave),
                ("zen", self.browser_zen),
            ) if button.get_active()
        ]

    def review(self, _button):
        error = ""
        if not self.disks:
            error = "No eligible installation disk was found."
        elif not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", self.username.get_text()):
            error = "Enter a simple lowercase username."
        elif not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.-]{0,62}", self.hostname.get_text()):
            error = "Enter a valid computer name."
        elif len(self.password.get_text()) < 8:
            error = "Use a password with at least 8 characters."
        elif self.password.get_text() != self.password_confirm.get_text():
            error = "The passwords do not match."
        elif not self.connected():
            error = "Connect to Wi-Fi or Ethernet. SpectrumOS downloads packages during installation."
        if error:
            self.error.set_text(error)
            self.error.set_visible(True)
            return
        self.error.set_visible(False)
        disk = self.disks[self.disk_dropdown.get_selected()]
        browser_labels = {"chrome": "Google Chrome", "brave": "Brave", "zen": "Zen Browser"}
        browsers = ", ".join(browser_labels[name] for name in self.selected_browsers()) or "None"
        self.summary.set_text(
            f"Disk\n{self.disk_label(disk)}\n\nAccount\n{self.username.get_text()} on {self.hostname.get_text()}\n\n"
            f"Timezone\n{self.timezones[self.timezone.get_selected()]}\n\nGraphics\n{self.gpus[self.gpu.get_selected()]}\n\n"
            f"Keyboard\n{self.keyboard_names[self.keyboard.get_selected()]}\n\n"
            f"Installation\n{'Lean' if self.lean.get_active() else 'Full'}\n\n"
            f"Optional browsers\n{browsers}\n\n"
            "Filesystem\nBtrfs with separate home and snapshots subvolumes"
        )
        self.stack.set_visible_child_name("confirm")

    def start_install(self, _button):
        self.stack.set_visible_child_name("progress")
        self.progress.set_fraction(0)
        self.package_total = 0
        self.package_seen = 0
        self.package_floor = 0
        self.package_ceiling = 0
        self.awaiting_package_floor = False
        thread = threading.Thread(target=self.install_worker, daemon=True)
        thread.start()

    def install_worker(self):
        disk = self.disks[self.disk_dropdown.get_selected()]["path"]
        gpu = self.gpu_profiles[self.gpu.get_selected()]
        password_path = None
        try:
            descriptor, password_path = tempfile.mkstemp(prefix="spectrum-password-", dir="/tmp")
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                handle.write(self.password.get_text() + "\n")
            command = [
                "pkexec", BACKEND, "--apply", "--disk", disk, "--confirm-erase", disk,
                "--username", self.username.get_text(), "--hostname", self.hostname.get_text(),
                "--timezone", self.timezones[self.timezone.get_selected()], "--password-file", password_path,
                "--cpu", self.detect_cpu(), "--gpu", gpu,
                "--keyboard", self.keyboard_profiles[self.keyboard.get_selected()],
                "--form-factor", "laptop" if self.laptop.get_active() else "desktop",
                "--browsers", ",".join(self.selected_browsers()),
            ]
            if self.lean.get_active():
                command.append("--lean")
            # errors="replace": paru/makepkg builds an AUR helper from source when
            # optional browsers are requested, and cargo/rustc output isn't
            # guaranteed clean UTF-8 on every line -- confirmed live, a decode
            # error here raises UnicodeDecodeError from inside this loop, which
            # `except OSError` below does not catch (it isn't an OSError), so
            # this whole background thread died silently and the installer
            # window never showed a finish or error page again.
            process = subprocess.Popen(
                command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, encoding="utf-8", errors="replace",
            )
            assert process.stdout is not None
            for line in process.stdout:
                GLib.idle_add(self.handle_line, line)
            result = process.wait()
            GLib.idle_add(self.finish_install, result)
        except OSError as error:
            GLib.idle_add(self.append_log, f"Could not start installer: {error}\n")
            GLib.idle_add(self.finish_install, 1)
        finally:
            if password_path:
                try:
                    Path(password_path).unlink()
                except FileNotFoundError:
                    pass

    def append_log(self, line):
        buffer = self.log.get_buffer()
        buffer.insert(buffer.get_end_iter(), line)
        # Without this the view stays wherever it was scrolled to (the top, on
        # first open) as new lines keep landing below the visible area --
        # confirmed live: the log never auto-followed the install, so watching
        # progress meant repeatedly scrolling down by hand.
        self.log.scroll_to_iter(buffer.get_end_iter(), 0.0, False, 0.0, 0.0)
        return False

    def set_progress(self, percent):
        self.progress.set_fraction(max(0.0, min(1.0, percent / 100)))
        return False

    def handle_line(self, raw_line):
        # Building an optional browser's AUR package runs cargo/rustc, whose
        # own carriage-return-heavy progress meter can otherwise land here as
        # one multi-megabyte "line" (Python only splits stdout on '\n') --
        # capped before anything else touches it so neither the regexes below
        # nor the GTK text buffer ever have to deal with that.
        line = raw_line if len(raw_line) <= 8000 else raw_line[:8000] + "... [truncated]\n"
        try:
            self._handle_line(line)
        except Exception as error:
            # Never let a parsing hiccup on one line take the whole installer
            # down -- confirmed live, an unhandled exception raised from
            # inside a GLib.idle_add callback aborts the entire GTK process
            # with no error page and no message, mid-install.
            try:
                self.append_log(f"[installer] could not process a log line: {error}\n")
            except Exception:
                pass
        return False

    def _handle_line(self, line):
        packages_match = PACKAGES_RE.match(line)
        if packages_match:
            self.package_total = int(packages_match.group(1))
            self.package_ceiling = int(packages_match.group(2))
            self.package_seen = 0
            # The very next ##PROGRESS milestone is pacstrap's starting point
            # (backend always emits it right before pacstrap runs); anchor
            # the interpolation's floor to that instead of to whatever
            # unrelated milestone happens to precede this marker.
            self.awaiting_package_floor = True
            return
        progress_match = PROGRESS_RE.match(line)
        if progress_match:
            pct = int(progress_match.group(1))
            self.set_progress(pct)
            if self.awaiting_package_floor:
                self.package_floor = pct
                self.awaiting_package_floor = False
            else:
                # Any later milestone closes the pacstrap band, so pacman
                # output from later steps (e.g. building optional AUR
                # browsers) is never mistaken for more of it.
                self.package_total = 0
            return
        self.append_log(line)
        if self.package_total:
            resolved_match = PACMAN_RESOLVED_RE.match(line.strip())
            if resolved_match:
                self.package_total = int(resolved_match.group(1))
                self.package_seen = 0
        # Between pacstrap's floor and ceiling milestones, grow the bar off
        # pacman's own per-package output instead of leaving it stuck at the
        # floor for however long pacstrap -- by far the slowest single step
        # -- takes.
        if self.package_total and PACMAN_STEP_RE.match(line.strip()):
            self.package_seen = min(self.package_seen + 1, self.package_total)
            span = self.package_ceiling - self.package_floor
            estimate = self.package_floor + span * (self.package_seen / self.package_total)
            self.set_progress(estimate)
        return False

    def finish_install(self, result):
        if result == 0:
            self.set_progress(100)
            self.stack.set_visible_child_name("done")
        else:
            # Left wherever it stopped rather than reset to 0 -- that still
            # shows how far the install got before failing.
            self.append_log("\nInstallation stopped. Review the message above; no restart is required.\n")
        return False


if __name__ == "__main__":
    raise SystemExit(SpectrumInstaller().run(None))
