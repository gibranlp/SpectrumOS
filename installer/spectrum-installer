#!/usr/bin/env python3
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile
import threading

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import GLib, Gtk


DATA_DIR = Path(os.environ.get("SPECTRUM_INSTALLER_DATA", "/usr/share/spectrumos/installer"))
BACKEND = os.environ.get(
    "SPECTRUM_INSTALLER_BACKEND", "/usr/local/lib/spectrumos/spectrum-installer-backend"
)

# spectrum-installer-backend prints these instead of pulsing the bar blindly:
# ##PROGRESS marks a coarse stage milestone (0-100), ##PACKAGES announces the
# pacstrap package count plus the stage ceiling it's building toward, so the
# bar can grow smoothly across pacman's own "installing"/"upgrading" lines
# during pacstrap -- by far the slowest single step -- instead of sitting
# still between the milestones either side of it.
PROGRESS_RE = re.compile(r"^##PROGRESS (\d+)\s*$")
PACKAGES_RE = re.compile(r"^##PACKAGES (\d+) (\d+)\s*$")
PACMAN_STEP_RE = re.compile(r"^(?:installing|upgrading) \S+")
# pacman's own dependency-resolution summary ("Packages (487) name-1.0-1 ...")
# -- the ##PACKAGES count above is only the manifest's explicit package list,
# not what pacman actually resolves once transitive dependencies are pulled
# in (confirmed against a real build: ~100 explicit packages resolved to
# 487). Without this override the bar would race through the pacstrap band
# using the wrong (much smaller) denominator, then sit flat at its ceiling
# for most of pacstrap's real duration once installed count overtook it.
PACMAN_RESOLVED_RE = re.compile(r"^Packages \((\d+)\)")


class SpectrumInstaller(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.spectrumos.Installer")
        self.disks = []
        self.connect("activate", self.on_activate)

    def on_activate(self, _application):
        css = Gtk.CssProvider()
        css.load_from_path(str(DATA_DIR / "style.css"))
        Gtk.StyleContext.add_provider_for_display(
            self.get_active_window().get_display() if self.get_active_window() else self._display(),
            css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("Install SpectrumOS")
        self.window.set_default_size(760, 560)
        self.window.set_size_request(480, 360)
        self.window.set_decorated(False)

        shell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        shell.add_css_class("installer-shell")
        shell.append(self.hero())
        rescue_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        rescue_description = Gtk.Label(
            label="Recover an existing system without starting an installation.",
            xalign=0, wrap=True, hexpand=True,
        )
        rescue_description.add_css_class("muted")
        rescue_row.append(rescue_description)
        rescue_button = Gtk.Button(label="Rescue system")
        rescue_button.connect("clicked", self.open_rescue)
        rescue_row.append(rescue_button)
        shell.append(rescue_row)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        self.setup_page = self.build_setup_page()
        self.stack.add_named(self.setup_page, "setup")
        confirm_scroll = Gtk.ScrolledWindow()
        confirm_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        confirm_scroll.set_child(self.build_confirm_page())
        self.stack.add_named(confirm_scroll, "confirm")
        self.stack.add_named(self.build_progress_page(), "progress")
        self.stack.add_named(self.build_done_page(), "done")
        shell.append(self.stack)

        self.window.set_child(shell)
        self.window.present()

    def open_rescue(self, _button):
        try:
            subprocess.Popen([
                "uwsm", "app", "--", "foot", "--title=Rescue system", "-e",
                "/usr/local/bin/spectrum-rescue-shell",
            ])
        except OSError as error:
            Gtk.AlertDialog(
                message="Could not open the rescue terminal", detail=str(error),
            ).show(self.window)

