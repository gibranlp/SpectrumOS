    def field(self, box, title, widget):
        if isinstance(widget, Gtk.DropDown):
            selected = Gtk.SignalListItemFactory()
            selected.connect('setup', lambda _factory, item: item.set_child(
                Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE, max_width_chars=28)))
            selected.connect('bind', lambda _factory, item: item.get_child().set_text(item.get_item().get_string()))
            popup = Gtk.SignalListItemFactory()
            popup.connect('setup', lambda _factory, item: item.set_child(
                Gtk.Label(xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR, max_width_chars=38)))
            popup.connect('bind', lambda _factory, item: item.get_child().set_text(item.get_item().get_string()))
            widget.set_factory(selected)
            widget.set_list_factory(popup)
        label = tr_widget(Gtk.Label, label=msg(title), xalign=0)
        label.set_wrap(True)
        label.add_css_class("muted")
        box.append(label)
        box.append(widget)

    def build_language_controls(self, shell):
        self.language_rows = languages()
        self.changing_language = False
        self.region_edited = False
        self.translated_choices = []
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        language_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
        region_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
        self.language_choice = Gtk.DropDown.new_from_strings([item['name'] for item in self.language_rows])
        self.language_choice.set_selected(next((index for index, item in enumerate(self.language_rows)
                                               if item['id'] == language()), 0))
        self.language_choice.set_hexpand(True)
        self.field(language_box, 'Installation and system language', self.language_choice)
        self.region_choice = Gtk.DropDown.new_from_strings([item['locale'] for item in self.language_rows])
        self.region_choice.set_selected(self.language_choice.get_selected())
        self.region_choice.set_hexpand(True)
        self.field(region_box, 'Regional formats', self.region_choice)
        self.region_choice.connect('notify::selected', self.region_changed)
        self.language_choice.connect('notify::selected', self.language_changed)
        row.append(language_box)
        row.append(region_box)
        shell.append(row)

    def region_changed(self, *_arguments):
        if not self.changing_language:
            self.region_edited = True

    def language_changed(self, *_arguments):
        selected = self.language_choice.get_selected()
        if selected >= len(self.language_rows):
            return
        set_language(self.language_rows[selected]['id'])
        self.changing_language = True
        try:
            if not self.region_edited:
                self.region_choice.set_selected(selected)
            retranslate_widgets()
            for dropdown, sources in self.translated_choices:
                index = dropdown.get_selected()
                dropdown.set_model(Gtk.StringList.new([translate(value) for value in sources]))
                dropdown.set_selected(index)
            self.update_navigation()
            if self.stack.get_visible_child_name() == 'confirm':
                self.show_review()
        finally:
            self.changing_language = False

    def translated_dropdown(self, sources):
        dropdown = Gtk.DropDown.new_from_strings([translate(value) for value in sources])
        self.translated_choices.append((dropdown, sources))
        return dropdown

