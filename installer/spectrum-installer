            tr_set(self.confirm_warning, 'set_text', msg('Only the two new SpectrumOS partitions will be formatted. Existing partitions are preserved. Keep a backup of important files before partitioning.'))
            tr_set(self.install_button, 'set_label', msg('Install alongside'))
            created = "\n".join(translate("Create {path} ({role}) · sectors {start}–{end}",
                path=part['path'], role=part['role'], start=part['start'], end=part['end']) for part in plan["create"])
            storage_summary = translate(
                "Install alongside · {size} GiB\n\nBefore (all preserved)\n{before}\n\nAfter\nExisting partitions unchanged\n{created}\n\nBoot\n{boot}\nExisting Windows/Linux EFI loaders will be added when detected.",
                size=plan['size_gib'], before=self.partition_description(plan['preserve'], self.storage_layout['sector_size']),
                created=created, boot=translate('SpectrumOS menu first') if plan['default_boot'] else translate('Keep existing firmware entries first'))

        else:
            tr_set(self.confirm_warning, 'set_text', msg('Everything on the selected disk will be permanently erased. This cannot be undone.'))
            tr_set(self.install_button, 'set_label', msg('Erase disk and install'))
            storage_summary = translate("Erase the entire selected disk")
        browser_labels = {"chrome": "Google Chrome", "brave": "Brave", "zen": "Zen Browser"}
        browsers = ", ".join(browser_labels[name] for name in self.selected_browsers()) or translate("None")
        tr_set(self.summary, 'set_text', msg('Disk\n{value0}\n\n{value1}\n\nAccount\n{value2} on {value3}\n\nTimezone\n{value4}\n\nGraphics\n{value5}\n\nKeyboard\n{value6}\n\nInstallation\n{value7}\n\nOptional browsers\n{value8}\n\nLanguage\n{interface}\n\nRegional formats\n{region}\n\nFilesystem\nBtrfs with separate home and snapshots subvolumes', value0=self.disk_label(disk), value1=storage_summary, value2=self.username.get_text(), value3=self.hostname.get_text(), value4=self.timezones[self.timezone.get_selected()], value5=translate(self.gpus[self.gpu.get_selected()]), value6=translate(self.keyboard_names[self.keyboard.get_selected()]), value7=translate('Lean') if self.lean.get_active() else translate('Full'), value8=browsers, interface=self.language_rows[self.language_choice.get_selected()]['name'], region=self.language_rows[self.region_choice.get_selected()]['locale']))
        self.stack.set_visible_child_name("confirm")
        self.confirm_back.grab_focus()
        self.summary.select_region(0, 0)

    def start_install(self, _button):
        if self.install_running:
            return
        self.close_install_log()
        try:
            directory = Path(tempfile.mkdtemp(prefix="spectrum-installer-log-"))
            self.install_log_path = directory / "installation.log"
            descriptor = os.open(self.install_log_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            self.install_log_stream = os.fdopen(descriptor, "w", encoding="utf-8", buffering=1)
        except OSError as error:
            tr_set(self.confirm_warning, 'set_text', msg('Could not prepare the installation log: {value0}', value0=error))
            return
        self.install_options = {
            "locale": self.language_rows[self.language_choice.get_selected()]['locale'],
            "region": self.language_rows[self.region_choice.get_selected()]['locale'],
            "disk": self.disks[self.disk_dropdown.get_selected()]["path"],
            "gpu": self.gpu_profiles[self.gpu.get_selected()], "username": self.username.get_text(),
            "hostname": self.hostname.get_text(), "password": self.password.get_text(),
            "timezone": self.timezones[self.timezone.get_selected()],
            "keyboard": self.keyboard_profiles[self.keyboard.get_selected()],
            "form_factor": "laptop" if self.laptop.get_active() else "desktop",
            "browsers": ",".join(self.selected_browsers()), "lean": self.lean.get_active(),
            "storage_plan": self.storage_plan,
        }
        self.stack.set_visible_child_name("progress")
        self.progress.set_fraction(0)
        self.install_percent.set_text("0%")
        tr_set(self.install_status, 'set_text', msg('Getting ready'))
        tr_set(self.install_note, 'set_text', msg('Keep power and internet connected. This may take a little while.'))
        self.log.get_buffer().set_text("")
        self.install_running = True
        self.language_choice.set_sensitive(False)
        self.region_choice.set_sensitive(False)
        self.terminal_log_button.set_sensitive(True)
        self.done_log_button.set_sensitive(True)
        self.append_log("SpectrumOS installation log. Closing the log viewer does not stop installation.\n")
        self.tip_card.set_visible(True)
        self.tip_index = 0
        self.show_tip()
        self.stop_tip_timer()
        self.tip_timer = GLib.timeout_add_seconds(14, self.rotate_tip)
        self.package_total = 0
        self.package_seen = 0
        self.package_floor = 0
        self.package_ceiling = 0
        self.awaiting_package_floor = False
        thread = threading.Thread(target=self.install_worker, daemon=True)
        thread.start()

    def install_worker(self):
        options = self.install_options
        disk = options["disk"]
        password_path = None
        try:
            descriptor, password_path = tempfile.mkstemp(prefix="spectrum-password-", dir="/tmp")
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                handle.write(options["password"] + "\n")
            command = [
                "pkexec", BACKEND, "--apply", "--disk", disk,
                "--username", options["username"], "--hostname", options["hostname"],
                "--timezone", options["timezone"], "--password-file", password_path,
                "--cpu", self.detect_cpu(), "--gpu", options["gpu"],
                "--keyboard", options["keyboard"], "--form-factor", options["form_factor"],
                "--browsers", options["browsers"],
                "--locale", options["locale"], "--region", options["region"],
            ]
            plan = options["storage_plan"]
            if plan:
                command.extend(["--install-mode", "alongside", "--extent-start", str(plan["extent_start"]),
                                "--size-gib", str(plan["size_gib"]), "--confirm-plan", plan["confirmation"]])
                if not plan["default_boot"]:
                    command.append("--keep-boot-default")
            else:
                command.extend(["--install-mode", "erase", "--confirm-erase", disk])
            if options["lean"]:
                command.append("--lean")
            # errors="replace": paru/makepkg builds an AUR helper from source when
            # optional browsers are requested, and cargo/rustc output isn't
            # guaranteed clean UTF-8 on every line -- confirmed live, a decode
            # error here raises UnicodeDecodeError from inside this loop, which
            # `except OSError` below does not catch (it isn't an OSError), so
            # this whole background thread died silently and the installer
            # window never showed a finish or error page again.
            process = subprocess.Popen(
                command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, encoding="utf-8", errors="replace",
            )
            assert process.stdout is not None
            for line in process.stdout:
                GLib.idle_add(self.handle_line, line)
            result = process.wait()
            GLib.idle_add(self.finish_install, result)
        except OSError as error:
            GLib.idle_add(self.append_log, f"Could not start installer: {error}\n")
            GLib.idle_add(self.finish_install, 1)
        finally:
            if password_path:
                try:
                    Path(password_path).unlink()
                except FileNotFoundError:
                    pass

    def append_log(self, line):
        if self.install_log_stream is not None:
            try:
                self.install_log_stream.write(line)
            except OSError as error:
                self.close_install_log()
                line = f"[installer] Could not save further log output: {error}\n" + line
                self.show_log_window()
        buffer = self.log.get_buffer()
        buffer.insert(buffer.get_end_iter(), line)
        if buffer.get_char_count() > LOG_BUFFER_CHARS:
            end = buffer.get_start_iter()
            end.forward_chars(buffer.get_char_count() - LOG_BUFFER_CHARS)
            buffer.delete(buffer.get_start_iter(), end)
        if self.log_window is not None and self.log_window.get_visible():
            self.log.scroll_to_iter(buffer.get_end_iter(), 0.0, False, 0.0, 0.0)
        return False

    def set_progress(self, percent):
        fraction = max(0.0, min(1.0, percent / 100))
        self.progress.set_fraction(fraction)
        tr_set(self.install_percent, 'set_text', msg('{value0:.0f}%', value0=fraction * 100))
        return False

    def handle_line(self, raw_line):
        # Building an optional browser's AUR package runs cargo/rustc, whose
        # own carriage-return-heavy progress meter can otherwise land here as
        # one multi-megabyte "line" (Python only splits stdout on '\n') --
        # capped before anything else touches it so neither the regexes below
        # nor the GTK text buffer ever have to deal with that.
        line = raw_line if len(raw_line) <= 8000 else raw_line[:8000] + "... [truncated]\n"
        try:
            self._handle_line(line)
        except Exception as error:
            # Never let a parsing hiccup on one line take the whole installer
            # down -- confirmed live, an unhandled exception raised from
            # inside a GLib.idle_add callback aborts the entire GTK process
            # with no error page and no message, mid-install.
            try:
                self.append_log(f"[installer] could not process a log line: {error}\n")
            except Exception:
                pass
        return False

    def _handle_line(self, line):
        packages_match = PACKAGES_RE.match(line)
        if packages_match:
            self.package_total = int(packages_match.group(1))
            self.package_ceiling = int(packages_match.group(2))
            self.package_seen = 0
            # The very next ##PROGRESS milestone is pacstrap's starting point
            # (backend always emits it right before pacstrap runs); anchor
            # the interpolation's floor to that instead of to whatever
            # unrelated milestone happens to precede this marker.
            self.awaiting_package_floor = True
            return
        progress_match = PROGRESS_RE.match(line)
        if progress_match:
            pct = int(progress_match.group(1))
            self.set_progress(pct)
            tr_set(self.install_status, 'set_text', msg(next(title for threshold, title in reversed(INSTALL_STAGES) if pct >= threshold)))
            if self.awaiting_package_floor:
                self.package_floor = pct
                self.awaiting_package_floor = False
            else:
                # Any later milestone closes the pacstrap band, so pacman
                # output from later steps (e.g. building optional AUR
                # browsers) is never mistaken for more of it.
                self.package_total = 0
            return
        self.append_log(line)
        if self.package_total:
            if line.strip().lower().startswith(("downloading ", ":: retrieving packages")):
                tr_set(self.install_status, 'set_text', msg('Downloading packages'))
            resolved_match = PACMAN_RESOLVED_RE.match(line.strip())
            if resolved_match:
                self.package_total = int(resolved_match.group(1))
                self.package_seen = 0
        # Between pacstrap's floor and ceiling milestones, grow the bar off
        # pacman's own per-package output instead of leaving it stuck at the
        # floor for however long pacstrap -- by far the slowest single step
        # -- takes.
        if self.package_total and PACMAN_STEP_RE.match(line.strip()):
            tr_set(self.install_status, 'set_text', msg('Installing the base system'))
            self.package_seen = min(self.package_seen + 1, self.package_total)
            span = self.package_ceiling - self.package_floor
            estimate = self.package_floor + span * (self.package_seen / self.package_total)
            self.set_progress(estimate)
        return False

    def finish_install(self, result):
        self.install_running = False
        if result != 0:
            self.language_choice.set_sensitive(True)
            self.region_choice.set_sensitive(True)
        self.stop_tip_timer()
        if result == 0:
            self.set_progress(100)
            tr_set(self.install_status, 'set_text', msg('Installation complete'))
            self.append_log("\nSpectrumOS installation completed successfully.\n")
            self.close_install_log()
            self.stack.set_visible_child_name("done")
        else:
            tr_set(self.install_status, 'set_text', msg('Installation stopped'))
            tr_set(self.install_note, 'set_text', msg('Open the terminal log for details. You can also use Rescue system; no restart is required.'))
            self.tip_card.set_visible(False)
            self.append_log("\nInstallation stopped. Review the log before taking further action; no restart is required.\n")
            self.close_install_log()
        return False


if __name__ == "__main__":
    raise SystemExit(SpectrumInstaller().run(None))
