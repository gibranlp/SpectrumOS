    def on_activate(self, _application):
        if getattr(self, "window", None) is not None:
            self.window.present()
            return
        css = Gtk.CssProvider()
        css.load_from_path(str(DATA_DIR / "style.css"))
        Gtk.StyleContext.add_provider_for_display(
            self.get_active_window().get_display() if self.get_active_window() else self._display(),
            css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.window = tr_widget(Gtk.ApplicationWindow, application=self)
        tr_set(self.window, 'set_title', msg('Install SpectrumOS'))
        self.window.set_default_size(680, 560)
        self.window.set_size_request(480, 360)
        self.window.set_decorated(False)

        shell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        shell.add_css_class("installer-shell")
        shell.append(self.hero())
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        self.wizard_steps = ("language", "disk", "account", "preferences", "confirm")
        self.step_titles = ("Language", "Disk", "Account", "Preferences", "Review")
        for name, build in (("language", self.build_language_page), ("disk", self.build_disk_page),
                            ("account", self.build_account_page), ("preferences", self.build_preferences_page),
                            ("confirm", self.build_confirm_page)):
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroll.set_child(build())
            self.stack.add_named(scroll, name)
        self.stack.add_named(self.build_progress_page(), "progress")
        self.stack.add_named(self.build_done_page(), "done")
        shell.append(self.stack)
        self.error = tr_widget(Gtk.Label, xalign=0, wrap=True)
        self.error.add_css_class("warning")
        self.error.set_visible(False)
        shell.append(self.error)
        self.navigation = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.exit_button = tr_widget(Gtk.Button, label=msg('Exit installer'))
        self.exit_button.connect("clicked", lambda *_: self.quit())
        self.navigation.append(self.exit_button)
        self.navigation.append(Gtk.Box(hexpand=True))
        self.back_button = tr_widget(Gtk.Button, label=msg('Back'))
        self.back_button.connect("clicked", self.previous_step)
        self.navigation.append(self.back_button)
        self.next_button = tr_widget(Gtk.Button, label=msg('Continue'))
        self.next_button.add_css_class("accent")
        self.next_button.connect("clicked", self.next_step)
        self.navigation.append(self.next_button)
        self.navigation.append(self.confirm_actions)
        shell.append(self.navigation)
        self.stack.connect("notify::visible-child-name", self.update_navigation)
        self.stack.set_visible_child_name("language")
        self.update_navigation()

        self.window.set_child(shell)
        self.window.present()

    def open_rescue(self, _button):
        try:
            subprocess.Popen([
                "uwsm", "app", "--", "foot", "--title=Rescue system", "-e",
                "/usr/local/bin/spectrum-rescue-shell",
            ])
        except OSError as error:
            tr_widget(Gtk.AlertDialog, 
                message=msg('Could not open the rescue terminal'), detail=str(error),
            ).show(self.window)

    def update_navigation(self, *_arguments):
        if not hasattr(self, "navigation"):
            return
        name = self.stack.get_visible_child_name()
        editing = name in self.wizard_steps
        self.navigation.set_visible(editing)
        if not editing:
            self.error.set_visible(False)
            tr_set(self.step_indicator, 'set_text', msg('Installing SpectrumOS') if name == 'progress' else msg('Installation complete'))
            return
        index = self.wizard_steps.index(name)
        tr_set(self.step_indicator, 'set_text', msg('Step {step} of {total} · {title}',
               step=index + 1, total=len(self.wizard_steps), title=translate(self.step_titles[index])))
        self.back_button.set_visible(index > 0 and name != 'confirm')
        self.next_button.set_visible(name != 'confirm')
        self.confirm_actions.set_visible(name == 'confirm')
        self.exit_button.set_visible(name != 'confirm')
        self.navigation.set_sensitive(not self.storage_busy and not self.install_running)
        tr_set(self.next_button, 'set_label', msg('Review installation') if name == 'preferences' else msg('Continue'))

    def show_step(self, name):
        if self.storage_busy or self.install_running:
            return
        self.error.set_visible(False)
        self.stack.set_visible_child_name(name)

    def previous_step(self, _button):
        name = self.stack.get_visible_child_name()
        if name in self.wizard_steps and self.wizard_steps.index(name) > 0:
            self.show_step(self.wizard_steps[self.wizard_steps.index(name) - 1])

    def disk_validation_error(self):
        error = ""
        if not self.disks or self.disk_dropdown.get_selected() >= len(self.disks):
            error = "No eligible installation disk was found."
        elif not self.connected():
            error = "Connect to Wi-Fi or Ethernet. SpectrumOS downloads packages during installation."
        elif self.install_mode.get_selected() == 0 and (
            not self.storage_layout or self.storage_layout["blockers"] or not getattr(self, "extents", [])
            or self.extent_dropdown.get_selected() >= len(self.extents)
        ):
            error = "Read the partitions and select supported unallocated space before continuing."
        return error

    def account_validation_error(self):
        error = ""
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", self.username.get_text()):
            error = "Enter a simple lowercase username."
        elif not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9.-]{0,62}", self.hostname.get_text()):
            error = "Enter a valid computer name."
        elif len(self.password.get_text()) < 8:
            error = "Use a password with at least 8 characters."
        elif self.password.get_text() != self.password_confirm.get_text():
            error = "The passwords do not match."
        return error

    def next_step(self, _button):
        if self.storage_busy or self.install_running:
            return
        name = self.stack.get_visible_child_name()
        if name == 'preferences':
            self.review(None)
            return
        error = self.disk_validation_error() if name == 'disk' else self.account_validation_error() if name == 'account' else ''
        if error:
            tr_set(self.error, 'set_text', msg(error))
            self.error.set_visible(True)
            return
        if name in self.wizard_steps and self.wizard_steps.index(name) < len(self.wizard_steps) - 1:
            self.show_step(self.wizard_steps[self.wizard_steps.index(name) + 1])

