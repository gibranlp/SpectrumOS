            return
        self.alongside_box.set_visible(self.install_mode.get_selected() == 0)
        self.storage_plan = None

    def storage_disk_changed(self, *_arguments):
        self.storage_layout = None
        self.storage_plan = None
        self.extents = []
        self.extent_dropdown.set_model(Gtk.StringList.new([translate("Read partitions first")]))
        self.extent_dropdown.set_sensitive(False)
        self.allocation.set_sensitive(False)
        tr_set(self.storage_status, 'set_text', msg('Read the partition layout for the selected disk.'))

    def probe_storage(self, *_arguments):
        if self.storage_busy or not self.disks:
            return
        disk = self.disks[self.disk_dropdown.get_selected()]["path"]
        self.storage_disk_changed()
        self.set_storage_busy(True)
        tr_set(self.storage_status, 'set_text', msg('Reading partitions…'))

        def worker():
            try:
                result = subprocess.run(["pkexec", BACKEND, "--inspect-disk", disk],
                                        text=True, capture_output=True, timeout=90)
                if result.returncode:
                    raise ValueError(result.stderr.strip() or "Could not read the disk layout")
                layout = json.loads(result.stdout)
                GLib.idle_add(self.finish_storage_probe, layout, "")
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                GLib.idle_add(self.finish_storage_probe, None, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def set_storage_busy(self, busy):
        self.storage_busy = busy
        self.read_partitions.set_sensitive(not busy)
        self.disk_dropdown.set_sensitive(not busy and bool(self.disks))
        self.install_mode.set_sensitive(not busy)
        self.update_navigation()

    def finish_storage_probe(self, layout, error):
        self.set_storage_busy(False)
        if error:
            tr_set(self.storage_status, 'set_text', msg(error))
            return False
        self.storage_layout = layout
        self.extents = [item for item in layout["free_extents"] if item["bytes"] >= 34 * 1024**3]
        labels = [f"{item['bytes'] / 1024**3:.1f} GiB · start sector {item['start']}" for item in self.extents]
        self.extent_dropdown.set_model(Gtk.StringList.new(labels or [translate("No sufficiently large unallocated area")]))
        self.extent_dropdown.set_selected(0)
        usable = bool(self.extents) and not layout["blockers"]
        self.extent_dropdown.set_sensitive(usable)
        self.allocation.set_sensitive(usable)
        partitions = self.partition_description(layout["partitions"], layout["sector_size"])
        messages = "\n".join(layout["blockers"])
        tr_set(self.storage_status, 'set_text', msg('Current partitions (preserved):\n{partitions}\n\n{messages}', partitions=partitions or translate('None'), messages=messages))
        self.extent_changed()
        return False

    def extent_changed(self, *_arguments):
        if self.changing_language:
            return
        extents = getattr(self, "extents", [])
        index = self.extent_dropdown.get_selected()
        if index < len(extents):
            maximum = extents[index]["bytes"] // 1024**3
            self.allocation.set_range(34, maximum)
            self.allocation.set_value(maximum)
        self.storage_plan = None

    @staticmethod
    def partition_description(partitions, sector_size):
        return "\n".join(
            f"{part['path']} · {part.get('label') or part.get('name') or part.get('fstype') or 'Unknown'} · "
            f"{part['size'] * sector_size / 1024**3:.1f} GiB"
            for part in sorted(partitions, key=lambda item: item["start"])
        )

    def connected(self):
        try:
            state = subprocess.check_output(
                ["nmcli", "--terse", "--fields", "STATE", "general"],
                text=True,
                timeout=3,
            ).strip().lower()
        except (OSError, subprocess.SubprocessError):
            return False
        return state.startswith("connected")

    def refresh_network_status(self):
        online = self.connected()
        tr_set(self.network_status, 'set_text', msg(
            "Network connected · internet is required" if online
            else "Connect to Wi-Fi or Ethernet before installing"
        ))
        return True

    def keyboard_changed(self, _dropdown, _parameter):
        if self.changing_language:
            return
        profile = self.keyboard_profiles[self.keyboard.get_selected()]
        if profile == "us-intl":
            layouts, variants, options = "us", "intl", ""
        elif profile == "us-intl,latam":
            layouts, variants, options = "us,latam", "intl,", "grp:alt_shift_toggle"
        elif profile == "us-intl,es":
            layouts, variants, options = "us,es", "intl,", "grp:alt_shift_toggle"
        else:
            layouts, variants = profile, ""
            options = "grp:alt_shift_toggle" if "," in profile else ""
        for key, value in (
            ("input:kb_layout", layouts),
            ("input:kb_variant", variants),
            ("input:kb_options", options),
        ):
            subprocess.run(["hyprctl", "keyword", key, value], check=False)

    @staticmethod
    def disk_label(item):
        size = int(item.get("size") or 0) / (1024**3)
        model = (item.get("model") or "Disk").strip()
        transport = (item.get("tran") or "").upper()
        return f"{model} · {size:.1f} GiB · {item['path']} {transport}".strip()

    @staticmethod
    def detect_gpu():
        try:
            output = subprocess.check_output(["lspci"], text=True).lower()
        except (OSError, subprocess.SubprocessError):
            return 1
        controllers = "\n".join(
            line for line in output.splitlines()
            if any(kind in line for kind in ("vga compatible controller", "3d controller", "display controller"))
        )
        if any(name in controllers for name in ("virtio", "vmware", "virtualbox")):
            return 5
        has_nvidia = "nvidia" in controllers
        has_intel = "intel" in controllers
        has_amd = "amd" in controllers or "ati" in controllers
        if has_nvidia and has_intel:
            return 3
        if has_nvidia and has_amd:
            return 4
        if has_nvidia:
            return 2
        if has_amd:
            return 0
        return 1

    @staticmethod
    def detect_cpu():
        value = Path("/proc/cpuinfo").read_text(encoding="utf-8", errors="ignore").lower()
        return "amd" if "authenticamd" in value else "intel"

    def selected_browsers(self):
        return [
            name for name, button in (
                ("chrome", self.browser_chrome),
                ("brave", self.browser_brave),
                ("zen", self.browser_zen),
            ) if button.get_active()
        ]

    def review(self, _button):
        if self.storage_busy:
            return
        disk_error = self.disk_validation_error()
        error = disk_error or self.account_validation_error()
        if error:
            self.show_step('disk' if disk_error else 'account')
            tr_set(self.error, 'set_text', msg(error))
            self.error.set_visible(True)
            return
        self.error.set_visible(False)
        if self.install_mode.get_selected() == 0:
            self.set_storage_busy(True)
            extent = self.extents[self.extent_dropdown.get_selected()]
            arguments = ["pkexec", BACKEND, "--storage-plan", "--disk",
                         self.disks[self.disk_dropdown.get_selected()]["path"],
                         "--extent-start", str(extent["start"]), "--size-gib", str(self.allocation.get_value_as_int())]
            if not self.default_boot.get_active():
                arguments.append("--keep-boot-default")

            def worker():
                try:
                    result = subprocess.run(arguments, text=True, capture_output=True, timeout=90)
                    if result.returncode:
                        raise ValueError(result.stderr.strip() or "Could not plan installation")
                    GLib.idle_add(self.finish_storage_plan, json.loads(result.stdout), "")
                except (OSError, ValueError, subprocess.SubprocessError) as failure:
                    GLib.idle_add(self.finish_storage_plan, None, str(failure))

            threading.Thread(target=worker, daemon=True).start()
            return
        self.storage_plan = None
        self.show_review()

    def finish_storage_plan(self, plan, error):
        self.set_storage_busy(False)
        if error:
            self.storage_plan = None
            self.show_step('disk')
            tr_set(self.error, 'set_text', msg(error))
            self.error.set_visible(True)
        else:
            self.storage_plan = plan
            self.show_review()
        return False

