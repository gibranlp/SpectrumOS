    def open_install_log(self, _button):
        if self.install_log_path is None:
            return
        try:
            process = subprocess.Popen([
                "foot", "--title=SpectrumOS installation log", "-e",
                "tail", "--lines=200", "--follow=name", "--retry", "--", str(self.install_log_path),
            ])
        except OSError:
            self.show_log_window()
