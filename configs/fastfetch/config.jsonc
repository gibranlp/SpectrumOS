{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/var/lib/spectrumos/appearance/lock-branding.png",
    "width": 26,
    "height": 16,
    "padding": { "right": 4 },
    "cache": false
  },
  "display": {
    "color": { "keys": "blue", "title": "blue" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    { "type": "disk", "folders": "/" },
    "battery",
    "break",
    "colors"
  ]
}
