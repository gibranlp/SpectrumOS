pkgname=spectrum-hyprland
pkgver=1.0.0
pkgrel=7
pkgdesc="Hyprland session defaults for SpectrumOS"
arch=(any)
url="https://spectrum.gibranlp.dev"
license=(MIT)
depends=('spectrum-base>=1.0.0' hyprland hypridle hyprlock polkit-gnome uwsm spectrum-theme xdg-desktop-portal-hyprland xdg-desktop-portal-gtk)
install=spectrum-hyprland.install
options=(!strip !debug)
_source_revision=354db7357ced589a
_source_root="spectrumos-source-$pkgver"
source=("spectrumos-source-$pkgver-$_source_revision.tar.zst")
sha256sums=('2e3d714702518f5ed065514bb86b65bda4992bc8d6f25cfe9663ce3fa89796da')

check() {
    local _project="$srcdir/$_source_root"
    python "$_project/scripts/validate-hyprland.py" \
        --config-dir "$_project/configs/hyprland"
}

package() {
    local _project="$srcdir/$_source_root"
    local defaults="$pkgdir/usr/share/spectrumos/hyprland"
    install -d -m 0755 "$defaults/gpu" "$pkgdir/usr/lib/spectrumos" \
        "$pkgdir/usr/share/spectrumos/hardware/nvidia" "$pkgdir/usr/share/licenses/$pkgname"
    install -m 0644 "$_project"/configs/hyprland/*.lua "$defaults/"
    install -m 0644 "$_project"/configs/hyprland/gpu/*.lua "$defaults/gpu/"
    install -m 0644 "$_project/configs/hyprland/hypridle.conf" "$defaults/"
    install -m 0755 "$_project/scripts/nvidia-offload" \
        "$pkgdir/usr/lib/spectrumos/nvidia-offload"
    install -m 0644 "$_project/system/modprobe.d/spectrumos-nvidia-power.conf" \
        "$pkgdir/usr/share/spectrumos/hardware/nvidia/spectrumos-nvidia-power.conf"
    install -m 0644 "$_project/packages/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
