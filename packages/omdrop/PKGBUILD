pkgname=omdrop
pkgver=0.16.1
pkgrel=3
pkgdesc='AirDrop command and receiver for SpectrumOS (experimental radio support)'
arch=('any')
url='https://github.com/brentkearney/omdrop-plugin'
license=('MIT')
options=(!debug)
depends=('bash' 'python' 'python-libarchive-c' 'keyutils' 'openssl' 'systemd'
         'polkit' 'iproute2' 'libnotify' 'xdg-utils' 'wl-clipboard' 'python-gobject')
optdepends=('omdrop-owl: AWDL radio backend for non-Apple Wi-Fi cards')
makedepends=('patch')
_commit=3f936be7faa7f49180ab5167fa82066ef6d79891
source=("omdrop-${_commit}.tar.gz::https://codeload.github.com/brentkearney/omdrop-plugin/tar.gz/${_commit}"
        'spectrum-integration.patch' 'omdrop-notify')
sha256sums=('3362266ea87318e0d6aec1e700efa3ac78356da168adcc5370a905b72eb19642'
            '41ea766896fbf9ed9d72e1def07040dfccbc08e1fa49736a820f39d901b3b66a'
            '59f2e8c9b250441c73116d0a74986f3df8c068df066bef3c8bac8590519817fb')

prepare() {
    cd "$srcdir/omdrop-plugin-$_commit"
    patch -Np1 -i "$srcdir/spectrum-integration.patch"
}

check() {
    cd "$srcdir/omdrop-plugin-$_commit"
    bash -n bin/omdrop
    python -m compileall -q bin
    bin/omdrop --version
}

package() {
    local project="$srcdir/omdrop-plugin-$_commit"
    install -d "$pkgdir/usr/lib/omdrop-plugin" "$pkgdir/usr/bin"
    cp -a "$project/bin" "$project/share" "$pkgdir/usr/lib/omdrop-plugin/"
    find "$pkgdir/usr/lib/omdrop-plugin" -type d -name __pycache__ -prune -exec rm -rf {} +
    install -m 0644 "$project/manifest.json" "$pkgdir/usr/lib/omdrop-plugin/manifest.json"
    ln -s /usr/lib/omdrop-plugin/bin/omdrop "$pkgdir/usr/bin/omdrop"
    install -Dm 0755 "$srcdir/omdrop-notify" "$pkgdir/usr/lib/spectrumos/omdrop-notify"
    install -Dm 0644 "$project/LICENSE" "$pkgdir/usr/share/licenses/omdrop/LICENSE"
    install -Dm 0644 "$project/README.md" "$pkgdir/usr/share/doc/omdrop/upstream.md"
}
