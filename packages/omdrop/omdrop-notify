#!/usr/bin/env python3
import subprocess
import sys


def notify(arguments):
    if "--exec" in arguments:
        position = arguments.index("--exec")
        notification = arguments[:position]
        action = arguments[position + 1:]
        if not action:
            return 2
        result = subprocess.run(["notify-send", "--app-name=SpectrumDrop", "--wait", "--action=default=Open", *notification],
                                capture_output=True, text=True, check=False)
        if result.returncode == 0 and result.stdout.strip() == "default":
            subprocess.Popen(action, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        return result.returncode
    return subprocess.run(["notify-send", "--app-name=SpectrumDrop", *arguments], check=False).returncode


if __name__ == "__main__":
    try:
        sys.exit(notify(sys.argv[1:]))
    except OSError:
        sys.exit(1)
