package() {
    "$srcdir/$_source_root/integrations/ukvm/install" "$srcdir/$_source_root" "$pkgdir"
    local _project="$srcdir/$_source_root"
    local spectrum="$pkgdir/usr/share/spectrumos" script
    install -Dm 0755 "$srcdir/hotkey-keyboard" "$pkgdir/usr/lib/spectrumos/hotkey-keyboard"
    install -Dm 0644 "$_project/integrations/hotkey/virtual-keyboard-unstable-v1.xml" "$pkgdir/usr/share/licenses/spectrum-desktop/virtual-keyboard-unstable-v1.xml"
    install -d -m 0755 \
        "$spectrum/spectrum-shell" \
        "$spectrum/terminal" "$spectrum/environment" "$spectrum/vlc" \
        "$pkgdir/usr/lib/spectrumos" "$pkgdir/usr/lib/systemd/user" \
        "$pkgdir/usr/lib/systemd/system-preset" "$pkgdir/usr/lib/sysusers.d" "$pkgdir/usr/lib/tmpfiles.d" \
        "$pkgdir/usr/share/libalpm/hooks" "$pkgdir/etc/NetworkManager/conf.d" "$pkgdir/etc/samba" "$pkgdir/etc/xdg" \
        "$pkgdir/usr/share/applications" "$pkgdir/usr/share/licenses/$pkgname" "$pkgdir/usr/share/licenses/questline" "$pkgdir/usr/bin"

    install -m 0644 "$_project"/configs/spectrum-shell/*.qml "$spectrum/spectrum-shell/"
    install -m 0644 "$_project"/configs/spectrum-shell/*.js "$spectrum/spectrum-shell/"
    install -d -m 0755 "$spectrum/spectrum-shell/igor"
    install -m 0644 "$_project"/configs/spectrum-shell/igor/*.svg "$spectrum/spectrum-shell/igor/"
    install -m 0644 "$_project"/configs/terminal/* "$spectrum/terminal/"
    install -Dm644 "$_project/configs/terminal/kitty-user.conf" "$pkgdir/etc/skel/.config/kitty/kitty.conf"
    install -Dm644 "$_project/configs/terminal/alacritty-user.toml" "$pkgdir/etc/skel/.config/alacritty/alacritty.toml"
    install -Dm 0644 "$_project/configs/fastfetch/config.jsonc" \
        "$pkgdir/etc/xdg/fastfetch/config.jsonc"
    install -m 0644 "$_project"/configs/environment/90-spectrumos-qt.conf \
        "$spectrum/environment/90-spectrumos-qt.conf"
    install -m 0644 "$_project/system/spectrumos/font-families.conf" \
        "$spectrum/font-families.conf"
    install -m 0644 "$_project/configs/vlc/vlcrc" "$spectrum/vlc/vlcrc"
    install -m 0644 "$_project/configs/networkmanager/20-spectrumos.conf" \
        "$pkgdir/etc/NetworkManager/conf.d/20-spectrumos.conf"
    install -m 0644 "$_project/configs/samba/smb.conf" "$pkgdir/etc/samba/smb.conf"
    install -m 0644 "$_project/configs/xdg/mimeapps.list" "$pkgdir/etc/xdg/mimeapps.list"
    install -m 0644 "$_project/system/sysusers.d/spectrumos-sharing.conf" \
        "$pkgdir/usr/lib/sysusers.d/spectrumos-sharing.conf"
    install -m 0644 "$_project/system/tmpfiles.d/spectrumos-sharing.conf" \
        "$pkgdir/usr/lib/tmpfiles.d/spectrumos-sharing.conf"

    install -Dm644 "$_project/system/udev/rules.d/70-spectrumos-legion-rgb.rules" \
        "$pkgdir/usr/lib/udev/rules.d/70-spectrumos-legion-rgb.rules"

    install -Dm644 "$_project/system/udev/rules.d/70-spectrumos-keychron-rgb.rules" \
        "$pkgdir/usr/lib/udev/rules.d/70-spectrumos-keychron-rgb.rules"

    install -Dm644 "$_project/system/udev/rules.d/70-spectrumos-win60-rgb.rules" \
        "$pkgdir/usr/lib/udev/rules.d/70-spectrumos-win60-rgb.rules"

    install -Dm644 "$_project/system/modules-load.d/spectrumos-ddc.conf" "$pkgdir/usr/lib/modules-load.d/spectrumos-ddc.conf"

    for script in \
        volume brightness theme-menu waybar-menu panel hyprland-menu font-size-menu font-family-menu application-menu calculator-menu \
        network-menu bluetooth-menu recorder-menu display-menu appearance-sync legion-rgb-sync keychron-rgb-sync win60-rgb-sync waybar-widgets \
        waybar-cava wallpaper-restore session-menu keyboard-layout spectrum-update-run window-pin-toggle spectrum-browser-defaults \
        spectrumdrop-adapter hotkey-adapter network-adapter system-adapter brightness-adapter control-adapter theme-adapter time-region-adapter mouse-adapter audio-recorder application-adapter app-store-adapter app-store-privileged app-store-paru-bridge idle-adapter screensaver-adapter appimage-adapter favorites-adapter media-adapter media-control weather-adapter workspace-layout waybar-workspace-icons performance-mode resource-monitor spectrum-shell spectrum-shell-launcher spectrum-shell-open spectrum-shell-session spectrum-shell-layout spectrum-gaming-session spectrum-shell-tools spectrum-shell-picker thunar-actions spectrum-desktop-cleanup spectrum-terminal-config spectrum-user-avatar questline-adapter questline-open questline-action questline-widget-state questline-notifications questline-sync questline-sync-control spectrum-update-check stash-open spectrum-focus; do
        install -m 0755 "$_project/scripts/$script" "$pkgdir/usr/lib/spectrumos/$script"
    done
    install -m 0644 "$_project/system/pacman-hooks/90-spectrumos-desktop-cleanup.hook" \
        "$pkgdir/usr/share/libalpm/hooks/90-spectrumos-desktop-cleanup.hook"
    install -m 0644 "$_project/system/pacman-hooks/91-spectrumos-browser-defaults.hook" \
        "$pkgdir/usr/share/libalpm/hooks/91-spectrumos-browser-defaults.hook"
    install -Dm 0644 "$_project/system/polkit/org.spectrumos.time-region.policy" \
        "$pkgdir/usr/share/polkit-1/actions/org.spectrumos.time-region.policy"
    install -m 0755 "$_project/integrations/questline/spectrum-focus" "$pkgdir/usr/lib/spectrumos/questline-focus"
    install -m 0755 "$_project/scripts/pipewire-restart" \
        "$pkgdir/usr/lib/spectrumos/pipewire-restart"
    install -m 0644 "$_project/system/pacman-hooks/60-spectrumos-pipewire-restart.hook" \
        "$pkgdir/usr/share/libalpm/hooks/60-spectrumos-pipewire-restart.hook"

    install -m 0644 "$_project/system/systemd/user/spectrum-hotkey.service" "$pkgdir/usr/lib/systemd/user/spectrum-hotkey.service"
    install -m 0644 "$_project/system/systemd/user/spectrum-resource-monitor.service" \
        "$pkgdir/usr/lib/systemd/user/spectrum-resource-monitor.service"
    install -m 0644 "$_project/system/systemd/user/spectrum-questline-notifications.service" \
        "$pkgdir/usr/lib/systemd/user/spectrum-questline-notifications.service"
    install -m 0644 "$_project/system/systemd/user/spectrum-questline-sync.service" \
        "$pkgdir/usr/lib/systemd/user/spectrum-questline-sync.service"
    install -m 0644 "$_project/system/systemd/user/spectrum-shell.service" \
        "$pkgdir/usr/lib/systemd/user/spectrum-shell.service"
    install -m 0644 "$_project/system/systemd/user/spectrum-workspace-layout.service" \
        "$pkgdir/usr/lib/systemd/user/spectrum-workspace-layout.service"
    install -m 0644 "$_project/system/systemd/system-preset/60-spectrumos-desktop.preset" \
        "$pkgdir/usr/lib/systemd/system-preset/60-spectrumos-desktop.preset"

    install -m 0644 "$_project/packages/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -m 0644 "$srcdir/questline.LICENSE" "$pkgdir/usr/share/licenses/questline/LICENSE"
    install -m 0755 "$srcdir/questline-$_questline_version-linux-x86_64" "$pkgdir/usr/bin/questline"
    install -m 0755 "$srcdir/stash-$_stash_version-linux-x86_64" "$pkgdir/usr/bin/stash"
    install -m 0644 "$_project/integrations/omdrop/spectrumdrop.desktop" "$pkgdir/usr/share/applications/spectrumdrop.desktop"
    install -m 0644 "$_project/system/spectrum-favorites.desktop" "$pkgdir/usr/share/applications/spectrum-favorites.desktop"
    install -m 0644 "$_project/system/spectrum-appimages.desktop" "$pkgdir/usr/share/applications/spectrum-appimages.desktop"
    install -m 0644 "$_project/system/spectrum-app-store.desktop" "$pkgdir/usr/share/applications/spectrum-app-store.desktop"
    install -Dm 0644 "$_project/configs/app-store/paru.conf" "$pkgdir/usr/share/spectrumos/app-store/paru.conf"
    install -Dm 0644 "$_project/system/polkit/org.spectrumos.app-store.policy" "$pkgdir/usr/share/polkit-1/actions/org.spectrumos.app-store.policy"
    install -m 0644 "$_project/integrations/stash/stash.desktop" "$pkgdir/usr/share/applications/stash.desktop"
    install -Dm 0644 "$_project/system/autostart/spectrum-kdeconnect-indicator.desktop" \
        "$pkgdir/etc/xdg/autostart/spectrum-kdeconnect-indicator.desktop"
}
