    "$srcdir/$_source_root/integrations/hotkey/build" "$srcdir/$_source_root" "$srcdir/hotkey-keyboard"
}

check() {
    install -Dm644 "$startdir/PKGBUILD" "$srcdir/$_source_root/packages/spectrum-desktop/PKGBUILD"
    makepkg --dir "$startdir" --printsrcinfo > "$srcdir/$_source_root/packages/spectrum-desktop/.SRCINFO"
    "$srcdir/$_source_root/integrations/ukvm/check" "$srcdir/$_source_root"
    local _project="$srcdir/$_source_root" script
    desktop-file-validate "$_project/system/autostart/spectrum-kdeconnect-indicator.desktop"
    desktop-file-validate "$_project/system/spectrum-favorites.desktop"
    desktop-file-validate "$_project/system/spectrum-app-store.desktop"
    desktop-file-validate "$_project/system/spectrum-appimages.desktop"
    for script in "$_project"/scripts/{volume,brightness,theme-menu,waybar-menu,panel,hyprland-menu,font-size-menu,font-family-menu,calculator-menu,network-menu,bluetooth-menu,recorder-menu,waybar-cava,session-menu,keyboard-layout,spectrum-update-run,spectrum-shell,spectrum-shell-launcher,spectrum-shell-open,spectrum-shell-session,spectrum-user-avatar,media-control,questline-open,stash-open}; do
        bash -n "$script"
    done
    python -m py_compile "$_project/scripts/favorites-adapter" "$_project/scripts/appimage-adapter" "$_project/scripts/network-adapter" "$_project/scripts/theme-adapter" "$_project/scripts/application-adapter" "$_project/scripts/idle-adapter" "$_project/scripts/media-adapter" "$_project/scripts/spectrum-shell-tools" "$_project/scripts/spectrum-shell-picker" "$_project/scripts/time-region-adapter" "$_project/scripts/mouse-adapter" "$_project/scripts/audio-recorder" "$_project/scripts/hotkey-adapter" "$_project/scripts/spectrumdrop-adapter"
    python -m py_compile "$_project/scripts/spectrum-update-check"
    python -m py_compile "$_project/scripts/system-adapter" "$_project/scripts/brightness-adapter" "$_project/scripts/control-adapter" "$_project/scripts/display-menu" "$_project/scripts/weather-adapter" "$_project/scripts/workspace-layout" "$_project/scripts/waybar-workspace-icons" "$_project/scripts/appearance-sync" "$_project/scripts/legion-rgb-sync" "$_project/scripts/keychron-rgb-sync" "$_project/scripts/win60-rgb-sync" "$_project/scripts/performance-mode" "$_project/scripts/resource-monitor" "$_project/scripts/window-pin-toggle" "$_project/scripts/spectrum-shell-layout" "$_project/scripts/spectrum-gaming-session" "$_project/scripts/questline-adapter" "$_project/scripts/questline-action" "$_project/scripts/questline-widget-state" "$_project/scripts/questline-notifications" "$_project/scripts/questline-sync" "$_project/scripts/questline-sync-control"
    cd "$_project"
    python -m unittest tests.test_packaging.PackagingTests.test_desktop_frontend_install_loop_ships_app_store_helpers
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python3 tests/run_widget_polling.py
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python3 tests/run_shell_focus.py
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python3 tests/run_launcher.py
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python3 tests/run_capture_notifications.py
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python3 tests/run_questline_notifications.py
    local _media_runtime="$srcdir/media-test-runtime"
    install -d -m 700 "$_media_runtime"
    XDG_RUNTIME_DIR="$_media_runtime" QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python3 tests/run_media.py
    python -m unittest tests.test_widget_device_controls tests.test_brightness tests.test_hotkey tests.test_spectrumdrop
    python -m unittest tests.test_app_store tests.test_appimage tests.test_screensaver
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_Screensaver.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_SpectrumDrop.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_HotKey.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_DeviceControls.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python3 tests/run_audio_widget.py
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_DisplayScale.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python3 tests/run_app_store.py
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python3 tests/run_favorites.py
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_AppImages.qml
    python -m unittest \
        tests.test_stable_updates tests.test_favorites tests.test_flatpak tests.test_bar_style tests.test_gaming_profile tests.test_thunar_actions tests.test_waybar tests.test_wofi tests.test_desktop_cleanup tests.test_network_menu tests.test_spectrum_shell_network tests.test_spectrum_shell_picker tests.test_panel \
        tests.test_hyprland_menu tests.test_display_menu tests.test_recorder_menu tests.test_eww tests.test_weather tests.test_installer tests.test_rescue_shell tests.test_workspace_layout tests.test_appearance_sync tests.test_legion_rgb_sync tests.test_keychron_rgb_sync tests.test_browser_defaults tests.test_performance_mode tests.test_notifications \
        tests.test_font_size_menu tests.test_font_family_menu tests.test_theme_menu tests.test_idle_adapter tests.test_hyprland_config tests.test_calculator_menu tests.test_resource_monitor tests.test_session_menu tests.test_system_adapter tests.test_spectrum_update_run tests.test_window_pin_toggle tests.test_time_region_adapter tests.test_igor tests.test_shell_idle tests.test_desktop_branding tests.test_user_avatar tests.test_questline_adapter tests.test_questline_widget_state tests.test_media_adapter tests.test_media_control tests.test_fastfetch tests.test_stash tests.test_mouse_adapter tests.test_audio_recorder
    QUESTLINE_TEST_BINARY="$srcdir/questline-$_questline_version-linux-x86_64" python -m unittest tests.test_questline_autosave tests.test_questline_notifications
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_QuestlineTree.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_QuestlineDrafts.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python tests/run_dashboard_hover.py
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_DashboardHover.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_QuestlineCalendar.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software python tests/run_questline_workspace.py
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_IgorCoverage.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_ShellMotion.qml
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /usr/lib/qt6/bin/qmltestrunner -input tests/qml/tst_WidgetAction.qml
