pkgname=spectrum-igor
pkgver=0.3.4
pkgrel=1
pkgdesc="Free Igor desktop companion runtime for SpectrumOS"
arch=(any)
url="https://spectrum.gibranlp.dev"
license=(MIT)
depends=(qt6-declarative qt6-svg python python-pillow openssl libsecret 'quickshell>=0.3.0')
makedepends=(qt6-tools)
options=(!strip !debug)
_runtime_version=0.3.4
_runtime_revision=967c714997740029
source=("igor-runtime-$_runtime_version-$_runtime_revision.tar.zst::https://spectrum.gibranlp.dev/sources/igor-runtime-$_runtime_version-$_runtime_revision.tar.zst" 'RuntimeTests.qml')
sha256sums=('ab2fb92bc565670c7f3ff506e516f521f21628602a5db762c94ccaada2f2f307'
            'fb67391626ee089b15a49842a396f309c61641fcaaeeb5c867242cdf20527c5d')

check() {
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QML_IMPORT_PATH="$srcdir" \
        /usr/lib/qt6/bin/qmltestrunner -input "$srcdir/RuntimeTests.qml"
}

package() {
    local destination="$pkgdir/usr/lib/qt6/qml/Spectrum/Igor"
    install -d -m 0755 "$destination/igor"
    install -m 0644 "$srcdir/Spectrum/Igor/"*.qml "$destination/"
    install -m 0644 "$srcdir/Spectrum/Igor/IgorOutfits.js" "$destination/"
    install -m 0644 "$srcdir/Spectrum/Igor/qmldir" "$destination/"
    install -m 0644 "$srcdir/Spectrum/Igor/igor/"*.svg "$srcdir/Spectrum/Igor/igor/"*.png "$destination/igor/"
    install -d -m 0755 "$destination/Desktop"
    install -m 0644 "$srcdir/Spectrum/Igor/Desktop/qmldir" "$srcdir/Spectrum/Igor/Desktop/"*.qml "$destination/Desktop/"
    install -Dm 0755 "$srcdir/Spectrum/Igor/Desktop/igor-outfits" "$pkgdir/usr/lib/igor/igor-outfits"
    install -Dm 0755 "$srcdir/Spectrum/Igor/Desktop/igor-account" "$pkgdir/usr/lib/igor/igor-account"
    install -Dm 0644 "$srcdir/Spectrum/Igor/Desktop/igor_packs.py" "$pkgdir/usr/lib/igor/igor_packs.py"
    install -Dm 0644 "$srcdir/Spectrum/Igor/Desktop/pack-signing-public.pem" "$pkgdir/usr/share/igor/pack-signing-public.pem"
    install -Dm 0644 "$srcdir/Spectrum/Igor/catalog.json" "$pkgdir/usr/share/igor/catalog.json"
    install -Dm 0644 "$srcdir/Spectrum/Igor/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
